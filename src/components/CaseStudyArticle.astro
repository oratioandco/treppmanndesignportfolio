---
// Shared case-study renderer. Single source of truth for turning a CaseStudy
// record (data/case-studies/*.json in my-cv-tailor, synced into
// src/data/cv-tailor-data/case-studies/) into the editorial article layout.
// Used by both the canonical public route (src/pages/case-studies/[study].astro)
// and the tailored-audience route (src/pages/work/[slug]/[study].astro) so the
// two can never drift the way the old hand-authored homepage pages did.
import fs from 'node:fs';
import path from 'node:path';
import type { CaseStudy, CaseStudySection } from '../data/cv-tailor';

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;

// Format paragraphs from a content string with \n\n separators.
// Supports two pieces of markdown that survive in our content:
//   - `### Heading` paragraphs become <h3 class="cs-sublabel"> (editorial
//     sidehead with rule above).
//   - Stray **bold** inside body paragraphs becomes <strong>. Safety net
//     for legacy content; new content should use ### headings instead of
//     the "**Lead phrase.** body" pattern.
function paragraphs(content: string): string {
  return content
    .split(/\n{2,}/)
    .map((para) => {
      const trimmed = para.trim();
      if (trimmed.startsWith('### ')) {
        return `<h3 class="cs-sublabel">${trimmed.slice(4).trim()}</h3>`;
      }
      const withStrong = trimmed.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
      return `<p>${withStrong}</p>`;
    })
    .join('');
}

// Browser text balancing improves a display block's rag but cannot guarantee
// that the final line will not contain one orphaned word. Joining the final
// three words with non-breaking spaces gives large titles and pull quotes a
// deterministic closing line without changing what assistive technology reads.
function preventDisplayWidow(text: string, keepWords = 2): string {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length <= 1) return text;
  const keep = Math.min(keepWords, words.length);
  const head = words.slice(0, -keep).join(' ');
  const tail = words.slice(-keep).join('\u00A0');
  return head ? `${head} ${tail}` : tail;
}

// HTML for a figure with a marginalia caption.
// The figure is a subgrid item so its caption can sit in the rail column on desktop.
function figure(img: { src: string; alt: string; caption?: string }, figNum: number): string {
  let html = `<figure class="cs-figure">`;
  html += `<img src="${img.src}" alt="${img.alt}" loading="lazy" />`;
  if (img.caption) {
    html += `<figcaption class="cs-caption">`;
    html += `<span class="cs-caption-tag">Fig. ${String(figNum).padStart(2, '0')}</span>`;
    html += `<span class="cs-caption-text">${img.caption}</span>`;
    html += `</figcaption>`;
  }
  html += `</figure>`;
  return html;
}

// Section opener: a small mono '§ NN' marker above the H2.
// Pure structural punctuation — no category label. The H2 below carries
// the section's meaning; the kicker is just a chapter-style marker.
function sectionOpener(num: string, title: string): string {
  return `<header class="cs-section-head">
    <span class="cs-section-label">§&nbsp;${num}</span>
    <h2 class="cs-section-title">${preventDisplayWidow(title)}</h2>
  </header>`;
}

// Render one section into the markup we want.
// We assign `§` numbers to non-hero sections sequentially, but skip pure callouts
// and key-takeaways (those are visually distinct, don't need a number).
function renderSection(section: CaseStudySection, sectionNum: number, figCounter: { n: number }): string {
  switch (section.type) {
    case 'hero':
      return ''; // handled by template hero block

    case 'narrative': {
      let html = '';
      if (section.headline) {
        html += sectionOpener(String(sectionNum).padStart(2, "0"), section.headline);
      }
      if (section.content) {
        html += `<div class="cs-body cs-body--dropcap">${paragraphs(section.content)}</div>`;
      }
      if (section.images) {
        for (const img of section.images) {
          figCounter.n += 1;
          html += figure(img, figCounter.n);
        }
      }
      return html;
    }

    case 'callout': {
      // Pure pull quote — breakout, ornament, byline-style context.
      let html = '<aside class="cs-pullquote">';
      html += '<span class="cs-pullquote-mark" aria-hidden="true">✱</span>';
      if (section.quote) html += `<blockquote class="cs-pullquote-text">${preventDisplayWidow(section.quote)}</blockquote>`;
      if (section.headline) html += `<p class="cs-pullquote-byline">${section.headline}</p>`;
      if (section.context) html += `<p class="cs-pullquote-context">${section.context}</p>`;
      if (section.content) html += `<div class="cs-body">${paragraphs(section.content)}</div>`;
      html += '</aside>';
      return html;
    }

    case 'process': {
      let html = '';
      if (section.headline) {
        html += sectionOpener(String(sectionNum).padStart(2, "0"), section.headline);
      }
      if (section.content) {
        html += `<div class="cs-body">${paragraphs(section.content)}</div>`;
      }
      if (section.steps) {
        html += '<ol class="cs-steps">';
        section.steps.forEach((step, i) => {
          html += '<li class="cs-step">';
          html += `<span class="cs-step-num" aria-hidden="true">${String(i + 1).padStart(2, '0')}</span>`;
          html += '<div class="cs-step-content">';
          html += `<h3 class="cs-step-label">${step.label}</h3>`;
          html += `<p>${step.description}</p>`;
          if (step.image) {
            figCounter.n += 1;
            html += figure(step.image, figCounter.n);
          }
          html += '</div></li>';
        });
        html += '</ol>';
      }
      // A process section could carry `images` and they rendered nowhere: only
      // per-step images were drawn, so a diagram attached to the section itself
      // was a reference the reader never saw. Silent, and worse than a broken
      // path, because a missing file at least fails a check. Placed after the
      // steps, where a diagram summarising them belongs.
      if (section.images) {
        section.images.forEach((image) => {
          figCounter.n += 1;
          html += figure(image, figCounter.n);
        });
      }
      return html;
    }

    case 'outcome': {
      let html = '';
      if (section.headline) {
        html += sectionOpener(String(sectionNum).padStart(2, "0"), section.headline);
      }
      if (section.metrics && section.metrics.length > 0) {
        html += '<dl class="cs-metrics">';
        for (const m of section.metrics) {
          html += '<div class="cs-metric">';
          html += `<dt class="cs-metric-label">${m.label}</dt>`;
          if (m.value) html += `<dd class="cs-metric-value">${m.value}</dd>`;
          if (m.before && m.after) html += `<dd class="cs-metric-change"><span class="cs-metric-before">${m.before}</span><span class="cs-metric-arrow" aria-hidden="true">→</span><span class="cs-metric-after">${m.after}</span></dd>`;
          html += '</div>';
        }
        html += '</dl>';
      }
      if (section.narrative) html += `<div class="cs-body">${paragraphs(section.narrative)}</div>`;
      if (section.content) html += `<div class="cs-body">${paragraphs(section.content)}</div>`;
      if (section.images) {
        for (const img of section.images) {
          figCounter.n += 1;
          html += figure(img, figCounter.n);
        }
      }
      return html;
    }

    case 'reflection': {
      let html = '';
      if (section.headline) {
        html += sectionOpener(String(sectionNum).padStart(2, "0"), section.headline);
      }
      if (section.content) {
        html += `<div class="cs-body cs-body--reflection">${paragraphs(section.content)}</div>`;
      }
      return html;
    }

    case 'key-takeaway': {
      let html = '<section class="cs-takeaway">';
      html += '<div class="cs-takeaway-rule" aria-hidden="true"></div>';
      if (section.headline) {
        html += `<span class="cs-takeaway-label">${section.headline.toUpperCase()}</span>`;
      }
      if (section.content) {
        html += `<div class="cs-body">${paragraphs(section.content)}</div>`;
      }
      html += '</section>';
      return html;
    }

    case 'comparison':
    case 'gallery':
    default: {
      let html = '';
      if (section.headline) {
        html += sectionOpener(String(sectionNum).padStart(2, "0"), section.headline);
      }
      if (section.content) html += `<div class="cs-body">${paragraphs(section.content)}</div>`;
      if (section.items && section.items.length > 0) {
        html += '<div class="cs-gallery">';
        for (const img of section.items) {
          figCounter.n += 1;
          html += figure(img, figCounter.n);
        }
        html += '</div>';
      }
      return html;
    }
  }
}

const heroSection = study.sections?.find((s: CaseStudySection) => s.type === 'hero');
const nonHeroSections = study.sections?.filter((s: CaseStudySection) => s.type !== 'hero') || [];

// Nearly every case study ends with a section whose content closes on a
// "Get in touch" prompt — a consistent, deliberate closer, not content to
// be trimmed by the executive/in-depth split below. Matched on the content
// ending, not on type/headline: most are headline-less `narrative`
// sections, but at least one (bibeltv-ai-prototyping) is a `key-takeaway`
// with its own headline ("Want the specifics?") — matching narrower would
// have silently missed that one and left its "Get in touch" as inert text
// with no button, the exact bug this is fixing for the others.
// (spreadshirt-user-research-strategy has no closer at all currently.)
const isCloser = (s: CaseStudySection) => !!s.content?.trim().endsWith('Get in touch.');
const closerSection = [...nonHeroSections].reverse().find(isCloser) ?? null;
const contentSections = closerSection
  ? nonHeroSections.filter((s) => s !== closerSection)
  : nonHeroSections;
// Strip the trailing CTA sentence itself — it becomes the button, not prose.
// Keep the section's own headline (if it has one) as a lead-in label.
const closerLeadIn = closerSection?.content
  ? closerSection.content.replace(/\s*Get in touch\.\s*$/, '').trim()
  : '';
const closerHooks = closerLeadIn
  .split(/\n{2,}/)
  .map((hook) => hook.trim())
  .filter(Boolean);
const closerHeadline = closerSection?.headline ?? '';

const pageTitle = heroSection?.headline || study.title;

// Every case study carries a `variants.executive` entry — a curated,
// shorter reading (the MVP-length version: 2-4 sections, ~2 min) alongside
// the full `in-depth` one. Neither this route nor /for/ ever read it before
// this — every page always rendered the complete section list regardless,
// which is why case studies kept reading as long after the MVP content pass
// even though the shorter cut existed in the data the whole time.
//
// `variant.sections` isn't consistent across the corpus: most studies list
// section `type`s ("callout", "outcome"), but at least one lists section
// `headline` text instead. Match on type first, falling back to headline,
// walking the variant's list in document order so a repeatable type
// (multiple "narrative" sections) resolves to the right occurrence rather
// than an arbitrary one.
function resolveVariantSections(
  all: CaseStudySection[],
  keys: string[] | undefined
): CaseStudySection[] | null {
  if (!keys || keys.length === 0) return null;
  const remaining = [...all];
  const picked: CaseStudySection[] = [];
  for (const key of keys) {
    if (key === 'hero') continue;
    const idx = remaining.findIndex((s) => s.type === key || s.headline === key);
    if (idx !== -1) picked.push(...remaining.splice(idx, 1));
  }
  return picked.length > 0 ? picked : null;
}

const executiveSections = resolveVariantSections(
  contentSections,
  study.variants?.executive?.sections
);
// Falls back to showing everything if a study has no usable executive
// variant (missing entirely, or its `sections` list didn't resolve to
// anything) — better to show the full case study than an empty one.
const shortSections = executiveSections ?? contentSections;
const shortKeySet = new Set(shortSections);

// Inline SVG hero images so they inherit the page's CSS variables (the
// diagram colors track the light/dark theme) and the site fonts. Raster
// heroes still render as a plain <img>.
let heroInlineSvg = '';
if (study.hero_image?.src?.endsWith('.svg')) {
  try {
    heroInlineSvg = fs.readFileSync(
      path.join(process.cwd(), 'public', study.hero_image.src),
      'utf8'
    );
  } catch (e) {
    heroInlineSvg = '';
  }
}

// Number only the section types that carry an opener (narrative, process, outcome,
// reflection, comparison, gallery, default). Skip callouts and key-takeaways.
// Numbered sequentially across the FULL section list (not per-bucket) so the
// numbering still reads correctly once "Read the full case study" is opened.
const figCounter = { n: 0 };
let sectionNum = 0;
const allRendered = contentSections.map((s) => {
  const isNumbered = !['callout', 'key-takeaway'].includes(s.type);
  if (isNumbered) sectionNum += 1;
  return { section: s, html: renderSection(s, sectionNum, figCounter), short: shortKeySet.has(s) };
}).filter((s) => s.html);
const renderedSections = allRendered.filter((s) => s.short);
const renderedExtraSections = allRendered.filter((s) => !s.short);
const hasMore = renderedExtraSections.length > 0;

// Hero kicker text. Falls back gracefully if fields are missing.
const kickerParts = ['Case Study'];
if (study.company) kickerParts.push(study.company);
if (study.duration) kickerParts.push(study.duration);
const kickerText = kickerParts.join(' · ').toUpperCase();
---

<header class="cs-hero-wrap">
  <div class="cs-hero-motif" aria-hidden="true">
    <svg class="echo-svg" data-slug={study.id} viewBox="0 0 200 200" fill="none"></svg>
  </div>
  <div class="cs-hero">
    <div class="cs-hero-text">
      <span class="cs-kicker">{kickerText}</span>
      <h1 class="cs-title">{preventDisplayWidow(pageTitle)}</h1>
      <p class="cs-tagline">{study.role}</p>
      {/* Scope. Every study carries `team` — "1 designer + engineering team,
          Berlin", "Team of five, including a design lead" — and it rendered
          nowhere, on either route. AUDIT.md's first finding against this
          portfolio was exactly that: "no role framing — what was his title,
          how big was the team, what was his scope? The reader has to infer
          seniority from the quality of the thinking, which is a bet most
          hiring managers won't make." The answer was in the data the whole
          time. */}
      {study.team && <p class="cs-scope">{study.team}</p>}
      {heroSection?.subtext && (
        <p class="cs-deck">{heroSection.subtext}</p>
      )}
      {!heroSection?.subtext && study.subtitle && (
        <p class="cs-deck">{study.subtitle}</p>
      )}
    </div>
    {study.hero_image && (
      <figure class="cs-hero-figure">
        {heroInlineSvg
          ? <Fragment set:html={heroInlineSvg} />
          : <img src={study.hero_image.src} alt={study.hero_image.alt} />}
      </figure>
    )}
  </div>
</header>
<script>
  import "../scripts/poster-motifs.js";
</script>

<article class="cs-article">
  {renderedSections.map(({ html }) => (
    <Fragment set:html={html} />
  ))}

  {/* MVP: no "read the full case study" expansion. The in-depth sections
      exist in the data (renderedExtraSections/hasMore above, deliberately
      unused here) for when the site is ready to go longer — until then,
      only the executive cut ever reaches the reader. */}

  {closerSection && (
    <section class="cs-contact">
      {closerHeadline && <p class="cs-contact-headline">{preventDisplayWidow(closerHeadline)}</p>}
      {closerHooks.length > 0 && (
        <ul class="cs-contact-hooks">
          {closerHooks.map((hook) => <li>{preventDisplayWidow(hook)}</li>)}
        </ul>
      )}
      {/* No mailto: in the markup — the address is assembled client-side
          from two data attributes so it never appears as a plain string
          in the page source for scrapers to lift. There was no prior
          contact/email pattern anywhere else on this site to match —
          checked before writing this, found none — so this is a new
          convention, not a reused one. */}
      <button
        type="button"
        class="cs-contact-button"
        data-user="hello"
        data-domain="treppmann.design"
      >
        Get in touch
      </button>
    </section>
  )}

  <p class="cs-endmark" aria-hidden="true">■</p>
</article>
<script>
  document.querySelectorAll('.cs-contact-button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const user = btn.getAttribute('data-user');
      const domain = btn.getAttribute('data-domain');
      window.location.href = `mailto:${user}@${domain}`;
    });
  });
</script>
<script>
  // Per-letter Redaction shimmer on the case-study title — same treatment as
  // the homepage hero headline: each letter perpetually shuffles between
  // Redaction weights at its own random cadence. Honours reduced-motion.
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.querySelector('.cs-title');
  if (title) {
    const text = title.textContent;
    title.innerHTML = text
      .split('')
      .map((char) => (/\s/.test(char) ? char : `<span class="letter">${char}</span>`))
      .join('');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      title.querySelectorAll('.letter').forEach((letter) => {
        let i = Math.floor(Math.random() * fonts.length);
        letter.style.fontFamily = `"${fonts[i]}", Georgia, serif`;
        const animate = () => {
          i = Math.floor(Math.random() * fonts.length);
          letter.style.fontFamily = `"${fonts[i]}", Georgia, serif`;
          setTimeout(animate, 1500 + Math.random() * 2500);
        };
        setTimeout(animate, Math.random() * 5000);
      });
    }
  }
</script>

<style is:global>
  /* =========================================================================
     CASE STUDY · EDITORIAL TYPOGRAPHY SYSTEM
     (is:global because section bodies are injected via set:html, which strips
     Astro's data-cid scoping attributes; scoped styles wouldn't apply.)
     -------------------------------------------------------------------------
     Layered grid: full-bleed / wide / body / rail / wide / full-bleed.
     Body prose stays narrow; section heads, pull quotes, and figures break
     out into adjacent zones. Captions sit in the rail on desktop, drop below
     on mobile.
     ========================================================================= */

  /* ----- Layout grid ------------------------------------------------------
     Two-column grid (body + rail) inside a centered max-width container.
     Body holds prose; rail holds image captions, marginalia, metadata.
     Hero, pull quotes, and tables span both columns. On narrow viewports
     the rail collapses below the body. */

  .cs-article {
    --body-width: 36rem;
    --rail-width: 14rem;
    --gutter: 2.5rem;

    max-width: calc(var(--body-width) + var(--gutter) + var(--rail-width) + 3rem);
    margin: 0 auto;
    padding: 0 1.5rem var(--space-2xl);

    display: grid;
    grid-template-columns:
      [body-start] minmax(0, var(--body-width))
      [body-end rail-start] var(--rail-width) [rail-end];
    column-gap: var(--gutter);
    row-gap: 0;
  }

  /* Default placement: body column. */
  .cs-article > * {
    grid-column: body;
    margin: 0;
  }

  /* Elements that span the entire grid width (body + gutter + rail).
     Each is also styled in its own block below; this rule only fixes
     grid-column placement, with parent specificity so it overrides the
     default `.cs-article > *` above. */
  .cs-article > .cs-hero,
  .cs-article > .cs-section-head,
  .cs-article > .cs-pullquote,
  .cs-article > .cs-figure,
  .cs-article > .cs-steps,
  .cs-article > .cs-metrics,
  .cs-article > .cs-takeaway,
  .cs-article > .cs-gallery {
    grid-column: 1 / -1;
  }

  /* Collapse to one column under ~50rem viewport. */
  @media (max-width: 50rem) {
    .cs-article {
      grid-template-columns: 1fr;
    }
    .cs-article > * {
      grid-column: 1;
    }
    .cs-article > .cs-hero,
    .cs-article > .cs-section-head,
    .cs-article > .cs-pullquote,
    .cs-article > .cs-figure,
    .cs-article > .cs-steps,
    .cs-article > .cs-metrics,
    .cs-article > .cs-takeaway,
    .cs-article > .cs-gallery {
      grid-column: 1;
    }
  }

  /* ----- Hero ------------------------------------------------------------
     Lives OUTSIDE the article max-width so it can run wider — magazine-
     cover scale. Uses its own centered 80rem container with edge padding,
     and gives the image a larger share than the text column. */

  /* The hero is an intentional poster, not a themed surface — same rule
     CaseStudyCard.astro follows for the listing cards. Hardcoded ink/cream,
     independent of the site's light/dark theme, so a case study's identity
     (its motif, its dark backdrop) carries unbroken from card to detail
     page instead of the motif suddenly sitting on a plain white or black
     page background depending on the visitor's theme. */
  .cs-hero-wrap {
    position: relative;
    overflow: hidden;
    background: #1a2520;
    margin-bottom: var(--space-xl);
    padding: var(--space-2xl) 1.5rem var(--space-xl);
  }

  .cs-hero-motif {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    /* Solid on the left where the text sits, fading out toward the right
       where the motif is free to read at full strength — guarantees text
       contrast regardless of what the generated shape looks like at any
       given point, without flattening the motif itself. */
    -webkit-mask-image: linear-gradient(100deg, transparent 0%, transparent 30%, black 62%);
    mask-image: linear-gradient(100deg, transparent 0%, transparent 30%, black 62%);
  }

  .cs-hero-motif .echo-svg {
    position: absolute;
    top: 50%;
    right: -8%;
    width: min(64vw, 52rem);
    height: min(64vw, 52rem);
    transform: translateY(-50%);
    animation: cs-hero-spin 140s linear infinite;
    transform-origin: 50% 50%;
  }

  .cs-hero-motif .echo-svg.no-whole-spin {
    animation: cs-hero-sway 22s ease-in-out infinite alternate;
  }

  @keyframes cs-hero-spin {
    to { transform: translateY(-50%) rotate(360deg); }
  }

  @keyframes cs-hero-sway {
    from { transform: translateY(-50%) rotate(-5deg) scale(1.02); }
    to   { transform: translateY(-50%) rotate(5deg) scale(1.02); }
  }

  /* The hero isn't a hover target like the card — it's ambient, so its
     tumble animation runs continuously rather than pausing until hover. */
  .cs-hero-motif :global(.tumble-el) {
    animation-play-state: running !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs-hero-motif .echo-svg { animation: none; }
    .cs-hero-motif :global(.tumble-el) { animation: none !important; }
  }

  @media (max-width: 40rem) {
    /* Small viewports stack text above the image; a full-bleed motif behind
       both reads as noise rather than atmosphere at that width. Fade it
       down instead of trying to mask around two stacked columns. */
    .cs-hero-motif { opacity: 0.35; }
    .cs-hero-motif { -webkit-mask-image: none; mask-image: none; }
  }

  .cs-hero {
    position: relative;
    z-index: 1;
    max-width: 80rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-2xl);
    align-items: end;
  }

  @media (max-width: 60rem) {
    .cs-hero-wrap {
      padding: var(--space-xl) 1.5rem var(--space-lg);
    }
    .cs-hero {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  .cs-hero-text {
    max-width: 36rem;
  }

  .cs-kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.4;
    letter-spacing: 0.08em;
    color: #b9cdc4;
    margin-bottom: var(--space-lg);
  }

  .cs-title {
    font-family: var(--font-display-20);
    font-style: italic;
    font-weight: normal;
    /* Bigger, more magazine-cover scale. */
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 0.92;
    color: #f4f1ea;
    margin: 0 0 var(--space-lg);
    letter-spacing: -0.015em;
    text-wrap: balance;
    orphans: 2;
    widows: 2;
  }

  .cs-tagline {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #f4f1ea;
    margin: 0 0 var(--space-md);
  }

  /* Sits under the role in the same mono register, one step quieter — scope is
