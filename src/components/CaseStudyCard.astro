---
// Poster-style case-study card: a continuously-animating generative motif
// (see src/scripts/flow-field-motifs.js) instead of a static cover image and
// hover-invert. Particles roam a noise-driven flow field across the card;
// the case study's shape acts as an obstacle they channel along / bounce off
// of, with pointer/touch displacement on top. The rAF loop only ever runs
// while the card is hovered/focused — zero cost while idle, stricter than
// the earlier SVG version's CSS animation-pause since no frame is even
// scheduled. See that script for the shape catalog and per-slug
// assignments, and .claude/skills/case-study-motif/SKILL.md for how to
// choose one (same judgment, now producing an obstacle field instead of an
// SVG generator).

interface Props {
  href: string;
  headline: string;
  caption: string;
  studyId: string;
}

const { href, headline, caption, studyId } = Astro.props;
---

<a href={href} class="cs-card">
  <div class="cs-card-top">
    <div class="cs-card-eyebrow">Case Study</div>
    <h3>{headline}</h3>
  </div>
  <div class="cs-card-art">
    <canvas class="flow-canvas" data-slug={studyId} width="200" height="200"></canvas>
  </div>
  <div class="cs-card-caption">
    <span>{caption}</span>
  </div>
</a>

<script>
  import "../scripts/flow-field-motifs.js";
</script>

<style>
  .cs-card {
    display: flex;
    flex-direction: column;
    position: relative;
    text-decoration: none;
    color: #f4f1ea;
    /* always the dark ink tone, independent of the site's light/dark theme
       — the card is intentionally a poster, not a themed surface */
    background: #1a2520;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    aspect-ratio: 5 / 8;
    /* the grid gives each card a fluid column width (see .case-studies-grid
       in global.css); uncapped, a 5:8 aspect ratio scales the card's HEIGHT
       right along with it, so past mobile widths the card balloons to fill
       most of the viewport. Capping width keeps the poster proportions
       intact at a size that actually reads as a card, not a full page. */
    max-width: 340px;
    margin: 0 auto;
    width: 100%;
    padding: 22px 22px 16px;
    transition:
      transform 0.35s ease-out,
      box-shadow 0.35s ease-out,
      border-color 0.35s ease-out;
  }

  .cs-card-top {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
  }

  .cs-card-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b9cdc4;
    margin-bottom: 6px;
  }

  .cs-card-top h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.12;
    margin: 0;
    color: #f4f1ea;
  }

  .cs-card-art {
    flex: 1 1 auto;
    display: grid;
    place-items: center;
    overflow: hidden;
    min-height: 0;
    margin: 4px 0;
    position: relative;
  }

  /* static shadow, completely outside the animating <svg> — rasterized
     once and reused every frame, never recomputed */
  .cs-card-art::before {
    content: "";
    position: absolute;
    inset: 6% 10% 10% 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.4), transparent 72%);
    filter: blur(7px);
    z-index: 0;
  }

  .cs-card-art canvas.flow-canvas {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    /* full-bleed within .cs-card-art, not inset — the trail-fade in
       flow-field-motifs.js repaints the canvas's own full rectangle every
       frame (unlike the old SVG, which only ever drew thin strokes over a
       transparent background). At any inset less than 100%, that rectangle
       becomes a visible solid-color edge against the card once particles
       fill it in, even though the fade color matches the card background —
       the SEAM is the bug, not the color. Full-bleed removes the seam by
       removing the boundary. (This also fully covers the ::before shadow
       blob below whenever the canvas is active, same as the 92% version
       did — the blob was already only ever visible at rest.)
       Internal resolution is fixed at 200x200 (see flow-field-motifs.js) and
       scaled via CSS, same tradeoff the SVG version made — the canvas draws
       fine strokes, not large flat fills, so upscaling reads as texture
       rather than blur. */
  }

  .cs-card-caption {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    display: flex;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: #cfd9d4;
    border-top: 1px solid rgba(244, 241, 234, 0.2);
    padding-top: 8px;
  }

  .cs-card:hover,
  .cs-card:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
    border-color: var(--color-accent);
  }
  .cs-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* prefers-reduced-motion is handled in flow-field-motifs.js (draws one
     static frame, never schedules a second) rather than here — there's no
     CSS animation left on the canvas itself to disable. */
</style>
