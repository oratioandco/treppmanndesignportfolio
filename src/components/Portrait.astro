---
/**
 * Portrait — the hero photograph.
 *
 * Previously the photo dissolved into discrete squares at its edges (a tiled
 * SVG mask that dropped tiles out near the border, fraying the silhouette).
 * That edge fray was removed per feedback: the pixel/tile language is kept
 * for other elements on the site (case-study covers, the dot field), but the
 * portrait itself now renders as a plain rectangular photo with no mask.
 */
interface Props {
  src?: string;
  srcset?: string;
  alt: string;
  class?: string;
}

const {
  src = '/images/portrait/tobias-treppmann.jpg',
  alt,
  class: className = '',
} = Astro.props as Props;
---

<figure class={`portrait ${className}`.trim()}>
  <img class="portrait__img" src={src} alt={alt} />
</figure>

<style>
  .portrait {
    margin: 0;
  }

  .portrait__img {
    display: block;
    width: 100%;
    height: auto;
    /* Matches the previous SVG viewBox's 600:750 (4:5) crop ratio, so the
       layout doesn't shift now that the mask is gone. */
    aspect-ratio: 4 / 5;
    object-fit: cover;
    /* No radius, no border, no inset shadow — matches the site's flat,
       paper-and-type rule rather than a soft-corner card treatment. */
  }
</style>
