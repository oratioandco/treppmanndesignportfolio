---
interface Image {
  src: string;
  alt: string;
  caption?: string;
}

interface Props {
  image: Image;
  index: number;
  eager?: boolean;
}

const { image, index, eager = false } = Astro.props as Props;

// Only dense evidence gets a route to the original. Ordinary photography and
// product imagery stay inside the reading flow; diagrams and inspectable UI
// retain their detail without turning every image into an unexplained link.
const inspectable = image.src.endsWith('.svg')
  || /(storybook|token|schema|builder|calendar|booking-form|prompt-input|dual-path|working-product|color-lab)/i.test(image.src);
---

<figure class="cs-spine-figure">
  {inspectable ? (
    <a
      class="cs-spine-figure__link"
      href={image.src}
      aria-label={`Open figure ${index} at full size`}
      target="_blank"
      rel="noreferrer"
    >
      <img src={image.src} alt={image.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
      <span>View full size ↗</span>
    </a>
  ) : (
    <img src={image.src} alt={image.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  )}
  {image.caption && (
    <figcaption>
      <span>Fig. {String(index).padStart(2, '0')}</span>
      <p>{image.caption}</p>
    </figcaption>
  )}
</figure>

<style>
  .cs-spine-figure {
    width: min(91%, 68rem);
    margin: clamp(2.5rem, 5vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4.5rem) auto;
  }

  .cs-spine-figure > img,
  .cs-spine-figure__link {
    display: block;
    width: 100%;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }

  .cs-spine-figure > img,
  .cs-spine-figure__link img {
    display: block;
    width: 100%;
    height: auto;
  }

  .cs-spine-figure__link {
    position: relative;
    overflow: hidden;
  }

  .cs-spine-figure__link > span {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.45rem 0.62rem;
    color: #f4f1ea;
    background: rgba(26, 37, 32, 0.92);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .cs-spine-figure__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }

  figcaption {
    display: grid;
    grid-template-columns: minmax(7rem, 0.28fr) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 3rem);
    align-items: start;
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  figcaption > span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.065em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  figcaption p {
    max-width: 56ch;
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.55;
  }

  @media (max-width: 48rem) {
    .cs-spine-figure {
      width: calc(100% + 2rem);
      margin-right: -1rem;
      margin-left: -1rem;
    }

    figcaption {
      grid-template-columns: 1fr;
      gap: 0.35rem;
      padding: 0 1rem;
    }
  }
</style>
