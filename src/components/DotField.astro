---
/**
 * DotField — a static halftone texture for the hero background.
 *
 * Previously the field resolved under the pointer (dots grew near the
 * cursor). That pointer-reactive behaviour was removed per feedback — the
 * dot grid now paints once as a static background texture and never
 * animates in response to the mouse.
 *
 * Canvas, not SVG. A 1440px hero holds ~600 dots; drawing them once on a
 * canvas is cheap and avoids 600 DOM nodes.
 *
 * Fails safe: no canvas support, or a thrown script → nothing renders, hero
 * is plain.
 *
 * aria-hidden and pointer-events:none throughout. It is decoration and must
 * never take a click meant for the text above it.
 */
interface Props {
  /** Grid spacing in CSS px. 34 matches the case-study cover system. */
  spacing?: number;
}
const { spacing = 34 } = Astro.props;
---

<div class="dotfield" aria-hidden="true" data-spacing={spacing}>
  <canvas></canvas>
</div>

<style>
  .dotfield {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none; /* decoration: never intercept a real click */
    z-index: 0;
  }
  .dotfield canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  interface Dot { x: number; y: number; base: number; cur: number }

  function initDotField(root: HTMLElement) {
    if (root.dataset.dfReady === '1') return;
    const canvas = root.querySelector('canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return; // no canvas → hero simply stays plain
    root.dataset.dfReady = '1';

    const spacing = Number(root.dataset.spacing) || 34;

    let dots: Dot[] = [];
    let w = 0, h = 0, dpr = 1;
    let ink = '#457468';

    function readInk() {
      const s = getComputedStyle(document.documentElement)
        .getPropertyValue('--color-accent').trim();
      if (s) ink = s;
    }

    function build() {
      const r = root.getBoundingClientRect();
      w = Math.max(1, Math.round(r.width));
      h = Math.max(1, Math.round(r.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2); // cap: 3x costs, shows nothing
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      const cols = Math.ceil(w / spacing);
      const rows = Math.ceil(h / spacing);
      for (let j = 0; j <= rows; j++) {
        for (let i = 0; i <= cols; i++) {
          const x = i * spacing + spacing / 2;
          const y = j * spacing + spacing / 2;
          // A faint, stable variation so the field is textured rather than a
          // perfect lattice. Deterministic in position — no RNG, so it does
          // not reshuffle on resize.
          const n = (Math.sin(x * 0.021) + Math.cos(y * 0.027) + Math.sin((x + y) * 0.011)) / 3;
          const base = 0.5 + n * 0.35;
          dots.push({ x, y, base, cur: base });
        }
      }
    }

    const maxR = spacing * 0.42;

    // Static paint: every dot renders at its resting radius. No pointer
    // tracking, no animation loop.
    function draw() {
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = ink;
      for (let k = 0; k < dots.length; k++) {
        const d = dots[k];
        if (d.cur > 0.35) {
          ctx.globalAlpha = Math.min(0.5, 0.06 + d.cur * 0.16);
          ctx.beginPath();
          ctx.arc(d.x, d.y, Math.min(maxR, d.cur), 0, 6.283185);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    const ro = new ResizeObserver(() => { build(); draw(); });
    ro.observe(root);

    // Theme is toggled by an attribute on <html>; re-read the ink when it flips.
    new MutationObserver(() => { readInk(); draw(); })
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    readInk();
    build();
    draw();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('.dotfield').forEach(initDotField);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('astro:page-load', initAll);
</script>
