---
import EvidenceFigure from './EvidenceFigure.astro';
import type { CaseStudy, CaseStudySection } from '../data/cv-tailor';

interface Props {
  study: CaseStudy;
  backUrl: string;
}

const { study, backUrl } = Astro.props as Props;

function splitParagraphs(content: string | undefined): string[] {
  return (content ?? '')
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

function inlineStrong(text: string): string {
  return text.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
}

function paragraphsHtml(content: string | undefined): string {
  return splitParagraphs(content)
    .map((paragraph) => {
      if (paragraph.startsWith('### ')) {
        return `<h3>${inlineStrong(paragraph.slice(4).trim())}</h3>`;
      }
      return `<p>${inlineStrong(paragraph)}</p>`;
    })
    .join('');
}

// CSS balance improves the rag, but it does not guarantee that a display line
// will not end with one stranded word. Keeping the last two words together is
// deterministic at every route and viewport, and leaves the source copy alone.
function preventDisplayWidow(text: string | undefined, keepWords = 2): string {
  if (!text) return '';
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length <= 1) return text;
  const keep = Math.min(keepWords, words.length);
  const head = words.slice(0, -keep).join(' ');
  const tail = words.slice(-keep).join('\u00A0');
  return head ? `${head} ${tail}` : tail;
}

function resolveVariantSections(
  all: CaseStudySection[],
  keys: string[] | undefined,
): CaseStudySection[] | null {
  if (!keys?.length) return null;
  const remaining = [...all];
  const picked: CaseStudySection[] = [];

  for (const key of keys) {
    if (key === 'hero') continue;
    const index = remaining.findIndex((section) => section.type === key || section.headline === key);
    if (index !== -1) picked.push(...remaining.splice(index, 1));
  }

  return picked.length ? picked : null;
}

function sectionLabel(section: CaseStudySection, index: number): string {
  if (section.type === 'outcome') return 'Evidence';
  if (section.type === 'process') return 'The mechanism';
  if (section.type === 'reflection') return 'The implication';
  if (section.type === 'key-takeaway') return 'The point';
  return index === 0 ? 'The condition' : 'The decision';
}

const sections = study.sections ?? [];
const hero = sections.find((section) => section.type === 'hero');
const nonHeroSections = sections.filter((section) => section.type !== 'hero');
const isCloser = (section: CaseStudySection) => !!section.content?.trim().endsWith('Get in touch.');
const closer = [...nonHeroSections].reverse().find(isCloser) ?? null;
const contentSections = closer ? nonHeroSections.filter((section) => section !== closer) : nonHeroSections;
const selectedSections = resolveVariantSections(
  contentSections,
  study.variants?.executive?.sections,
) ?? contentSections;

const visibleSections = selectedSections.filter((section) => (
  section.headline
  || section.content
  || section.quote
  || section.steps?.length
  || section.metrics?.length
  || section.images?.length
));
const selectedHasImage = visibleSections.some((section) => !!section.images?.length || !!section.steps?.some((step) => step.image));
// The accepted LLM-safe pilot deliberately showed one concrete system image
// even though its executive cut kept the supporting section out of the prose.
// Preserve that evidence rule generically: only borrow the first real image
// when the concise selection would otherwise show none.
const supportingEvidence = selectedHasImage
  ? null
  : contentSections.flatMap((section) => section.images ?? [])[0] ?? null;

const title = hero?.headline || study.title;
const projectArgument = hero?.subtext || study.subtitle;
const kicker = ['Case Study', study.company, study.duration].filter(Boolean).join(' · ').toUpperCase();
const closerLead = closer?.content?.replace(/\s*Get in touch\.\s*$/, '').trim() ?? '';
const closerHooks = splitParagraphs(closerLead);
let figureIndex = 0;
---

<article class="cs-spine-page">
  <header class="cs-spine-hero cs-card">
    <canvas
      class="flow-canvas cs-spine-field"
      data-slug={study.id}
      width="200"
      height="200"
      aria-hidden="true"
    ></canvas>

    <nav class="cs-spine-nav" aria-label="Case study navigation">
      <a href={backUrl}>← Back to portfolio</a>
      <span>{kicker}</span>
      <a href="mailto:hello@treppmann.design">Get in touch</a>
    </nav>

    <div class="cs-spine-hero-copy">
      <p class="cs-spine-hero-index" aria-hidden="true">{study.type}</p>
      <h1 id="cs-spine-title" class="cs-spine-title">{preventDisplayWidow(title)}</h1>
      <div class="cs-spine-hero-foot">
        <div class="cs-spine-meta">
          <p>{study.role}</p>
          {study.team && <span>{study.team}</span>}
        </div>
        {projectArgument && <p class="cs-spine-argument">{projectArgument}</p>}
      </div>
    </div>
  </header>

  <main class="cs-spine-article" aria-labelledby="cs-spine-title">
    {visibleSections.map((section, sectionIndex) => {
      const content = section.content || (section as CaseStudySection & { narrative?: string }).narrative;
      const contentParagraphs = splitParagraphs(content);
      const lead = contentParagraphs[0] ?? '';
      const hasOptionalDepth = section.type === 'narrative' && contentParagraphs.length > 3;
      const optionalDepth = hasOptionalDepth ? contentParagraphs.slice(1, -1).join('\n\n') : '';
      const remainder = hasOptionalDepth
        ? contentParagraphs.slice(-1).join('\n\n')
        : contentParagraphs.slice(1).join('\n\n');
      const hasHeading = !!section.headline;

      return (
        <section
          class:list={[
            'cs-spine-section',
            `cs-spine-section--${section.type}`,
            sectionIndex % 2 === 1 && 'cs-spine-section--offset',
          ]}
          aria-labelledby={hasHeading ? `cs-spine-section-${sectionIndex}` : undefined}
        >
          {hasHeading && (
            <div class="cs-spine-heading-wrap">
              <span class="cs-spine-section-mark" aria-hidden="true">
                {String(sectionIndex + 1).padStart(2, '0')} / {sectionLabel(section, sectionIndex)}
              </span>
              <h2 id={`cs-spine-section-${sectionIndex}`}>{preventDisplayWidow(section.headline)}</h2>
            </div>
          )}

          {section.quote && (
            <blockquote class="cs-spine-principle">
              <p>{preventDisplayWidow(section.quote)}</p>
              {section.context && <footer>{section.context}</footer>}
            </blockquote>
          )}

          {lead && <p class="cs-spine-lead" set:html={inlineStrong(lead)} />}

          {sectionIndex === 0 && supportingEvidence && (() => {
            figureIndex += 1;
            return <EvidenceFigure image={supportingEvidence} index={figureIndex} eager />;
          })()}

          {section.images?.map((image) => {
            figureIndex += 1;
            return <EvidenceFigure image={image} index={figureIndex} eager={sectionIndex === 0} />;
          })}

          {optionalDepth && (
            <details class="cs-spine-depth">
              <summary>Read the reasoning behind this decision</summary>
              <div class="cs-spine-copy" set:html={paragraphsHtml(optionalDepth)} />
            </details>
          )}

          {remainder && <div class="cs-spine-copy" set:html={paragraphsHtml(remainder)} />}

          {section.steps?.length && (
            <ol class="cs-spine-steps">
              {section.steps.map((step, stepIndex) => (
                <li>
                  <span class="cs-spine-step-number" aria-hidden="true">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <h3>{step.label}</h3>
                  <p>{step.description}</p>
                  {step.image && (() => {
                    figureIndex += 1;
                    return <EvidenceFigure image={step.image} index={figureIndex} />;
                  })()}
                </li>
              ))}
            </ol>
          )}

          {section.metrics?.length && (
            <dl class="cs-spine-metrics">
              {section.metrics.map((metric) => (
                <div class="cs-spine-metric">
                  <dt>{metric.label}</dt>
                  {metric.value && <dd class="cs-spine-metric-value">{metric.value}</dd>}
                  {metric.before && metric.after && (
                    <dd class="cs-spine-metric-change">
                      <span>{metric.before}</span>
                      <strong>{metric.after}</strong>
                    </dd>
                  )}
                </div>
              ))}
            </dl>
          )}
        </section>
      );
    })}

    <section class="cs-spine-contact" aria-labelledby="cs-spine-contact-title">
      <h2 id="cs-spine-contact-title">{preventDisplayWidow(closer?.headline || 'Want to hear more?')}</h2>
      {closerHooks.length > 0 && (
        <ul class="cs-spine-contact-hooks">
          {closerHooks.map((hook) => <li>{preventDisplayWidow(hook)}</li>)}
        </ul>
      )}
      <a href="mailto:hello@treppmann.design">Get in touch <span aria-hidden="true">↗</span></a>
    </section>
  </main>
</article>

<script>
  import '../scripts/flow-field-motifs.js';
</script>

<style is:global>
  .cs-spine-page {
    --spine-ink: #1a2520;
    --spine-paper: #f4f1ea;
    --spine-green: #a4c6b9;
    padding-bottom: 3rem;
  }

  .cs-spine-hero {
    position: relative;
    min-height: min(44rem, 80vh);
    overflow: hidden;
    padding: 0 clamp(1rem, 4vw, 4rem) clamp(2.5rem, 6vw, 5rem);
    color: var(--spine-paper);
    background: var(--spine-ink);
    isolation: isolate;
  }

  .cs-spine-field {
    position: absolute;
    z-index: -2;
    top: 50%;
    right: -8%;
    width: min(72vw, 70rem);
    height: auto;
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.9;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }

  .cs-spine-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(92deg, var(--spine-ink) 0%, var(--spine-ink) 38%, rgba(26, 37, 32, 0.88) 53%, rgba(26, 37, 32, 0.08) 100%);
    pointer-events: none;
  }

  .cs-spine-nav {
    min-height: 4.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid rgba(244, 241, 234, 0.22);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cs-spine-nav a { color: var(--spine-paper); text-decoration: none; }
  .cs-spine-nav a:last-child { justify-self: end; border-bottom: 1px solid var(--spine-green); }
  .cs-spine-nav span { color: var(--spine-green); text-align: center; }
  .cs-spine-nav a:hover, .cs-spine-nav a:focus-visible { color: var(--spine-green); opacity: 1; }

  .cs-spine-hero-copy {
    min-height: calc(min(44rem, 80vh) - 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .cs-spine-hero-index {
    margin: 0 0 0.9rem;
    color: var(--spine-green);
    font-family: var(--font-display-20);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-style: italic;
    line-height: 1;
  }

  .cs-spine-title {
    max-width: 13.5ch;
    margin: 0 0 clamp(2rem, 4vh, 3rem);
    color: var(--spine-paper);
    font-family: var(--font-body);
    font-size: clamp(3.35rem, 7vw, 7rem);
    font-style: normal;
    font-weight: 610;
    letter-spacing: -0.073em;
    line-height: 0.84;
    text-wrap: balance;
  }

  .cs-spine-hero-foot {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(25rem, 1.3fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
    border-top: 1px solid rgba(244, 241, 234, 0.22);
    padding-top: 1.2rem;
  }

  .cs-spine-meta p,
  .cs-spine-meta span {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.035em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .cs-spine-meta span {
    display: block;
    max-width: 50ch;
    margin-top: 0.35rem;
    color: var(--spine-green);
  }

  .cs-spine-argument {
    max-width: 54ch;
    margin: 0;
    color: #d7dfdb;
    font-size: clamp(1rem, 1.45vw, 1.25rem);
    line-height: 1.5;
  }

  .cs-spine-article {
    max-width: 86rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 4vw, 4rem);
  }

  .cs-spine-section {
    position: relative;
    padding: clamp(3.8rem, 7vw, 6.5rem) 0;
    border-top: 1px solid var(--color-rule);
  }

  .cs-spine-section:first-child { border-top: none; }

  .cs-spine-section--offset::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(50% - 50vw);
    background: color-mix(in srgb, var(--color-accent-light) 62%, transparent);
  }

  .cs-spine-heading-wrap {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .cs-spine-section-mark,
  .cs-spine-step-number,
  .cs-spine-metric dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.065em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .cs-spine-section-mark { padding-top: 0.7rem; color: var(--color-accent); }

  .cs-spine-heading-wrap h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: clamp(2.6rem, 5.2vw, 5.2rem);
    font-style: normal;
    font-weight: 570;
    letter-spacing: -0.063em;
    line-height: 0.91;
    text-wrap: balance;
    orphans: 2;
    widows: 2;
  }

  .cs-spine-lead {
    max-width: 39ch;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem) auto;
    color: var(--color-text);
    font-size: clamp(1.24rem, 2vw, 1.72rem);
    line-height: 1.38;
    text-wrap: pretty;
  }

  .cs-spine-copy {
    max-width: 40rem;
    margin-left: calc(32% + 2rem);
    color: var(--color-text);
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .cs-spine-copy p { margin: 0 0 1.3rem; }
  .cs-spine-copy p:last-child { margin-bottom: 0; }
  .cs-spine-copy h3 {
    margin: 2.5rem 0 0.8rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1rem;
    font-style: normal;
    font-weight: 650;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .cs-spine-depth {
    max-width: 40rem;
    margin: 0 0 2rem calc(32% + 2rem);
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .cs-spine-depth summary {
    padding: 0.9rem 0;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    line-height: 1.45;
    text-transform: uppercase;
    cursor: pointer;
  }
  .cs-spine-depth[open] summary { border-bottom: 1px solid var(--color-rule); }
  .cs-spine-depth .cs-spine-copy { margin-left: 0; padding: 1.25rem 0 1.5rem; }
  .cs-spine-depth summary:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }

  .cs-spine-principle {
    display: grid;
    grid-template-columns: minmax(18rem, 1.15fr) minmax(16rem, 0.85fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    margin: 0 0 4rem;
  }

  .cs-spine-principle p {
    max-width: 15ch;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-display-20);
    font-size: clamp(2.7rem, 5.2vw, 5rem);
    font-style: italic;
    line-height: 0.84;
    letter-spacing: -0.033em;
    text-wrap: balance;
    orphans: 2;
    widows: 2;
  }

  .cs-spine-principle footer {
    max-width: 40ch;
    padding-bottom: 0.55rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .cs-spine-steps {
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .cs-spine-steps li {
    display: grid;
    grid-template-columns: 4rem minmax(12rem, 0.55fr) minmax(18rem, 1.45fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
    padding: 1.8rem 0 2rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .cs-spine-step-number { color: var(--color-accent); }
  .cs-spine-steps h3 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 1.08rem;
    font-style: normal;
    font-weight: 650;
    line-height: 1.35;
  }
  .cs-spine-steps p { max-width: 58ch; margin: 0; color: var(--color-text); font-size: 0.95rem; line-height: 1.62; }
  .cs-spine-steps .cs-spine-figure { grid-column: 2 / -1; width: 100%; margin: 1rem 0 0; }

  .cs-spine-metrics { margin: clamp(2.5rem, 5vw, 4rem) 0 0; }
  .cs-spine-metric {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding: 1.7rem 0 2rem;
    border-top: 1px solid var(--color-rule);
  }
  .cs-spine-metric dt { color: var(--color-accent); }
  .cs-spine-metric dd { margin: 0; }
  .cs-spine-metric-value {
    color: var(--color-accent);
    font-family: var(--font-display-20);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-style: italic;
    line-height: 1.1;
  }
  .cs-spine-metric-change {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 5rem);
    line-height: 1.5;
  }
  .cs-spine-metric-change span { color: var(--color-text-muted); font-weight: 430; }
  .cs-spine-metric-change strong { position: relative; color: var(--color-text); font-weight: 560; }
  .cs-spine-metric-change strong::before {
    content: '↳';
    position: absolute;
    left: -1.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-weight: normal;
  }

  .cs-spine-contact {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    padding: clamp(4rem, 7vw, 7rem) 0 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .cs-spine-contact h2 {
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 560;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }
  .cs-spine-contact-hooks { margin: 0; padding: 0; list-style: none; }
  .cs-spine-contact-hooks li {
    max-width: 55ch;
    padding: 1rem 0 1.25rem;
    border-top: 1px solid var(--color-rule);
    color: var(--color-text);
    font-family: var(--font-display-20);
    font-size: clamp(1.4rem, 2.3vw, 2.25rem);
    font-style: italic;
    letter-spacing: -0.019em;
    line-height: 1.09;
    text-wrap: pretty;
    orphans: 2;
    widows: 2;
  }
  .cs-spine-contact-hooks li:last-child { border-bottom: 1px solid var(--color-rule); }
  .cs-spine-contact > a {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--color-accent);
    border-bottom: 1px solid var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .cs-spine-contact > a:hover { color: var(--color-accent); opacity: 1; }
  .cs-spine-nav a:focus-visible,
  .cs-spine-contact > a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }

  @media (max-width: 64rem) {
    .cs-spine-hero { min-height: 43rem; }
    .cs-spine-field { right: -26%; width: 80vw; }
    .cs-spine-copy,
    .cs-spine-depth { margin-left: 0; }
    .cs-spine-steps li { grid-template-columns: 3rem minmax(10rem, 0.6fr) minmax(16rem, 1.4fr); gap: 1.5rem; }
  }

  @media (max-width: 48rem) {
    .cs-spine-hero { min-height: 40rem; padding: 0 1rem 2rem; }
    .cs-spine-field { top: 5rem; right: -55%; width: 150vw; transform: none; opacity: 0.7; }
    .cs-spine-hero::after { background: linear-gradient(180deg, rgba(26, 37, 32, 0.12) 0%, rgba(26, 37, 32, 0.72) 43%, var(--spine-ink) 73%); }
    .cs-spine-nav { min-height: 4rem; grid-template-columns: 1fr auto; gap: 1rem; }
    .cs-spine-nav > span { display: none; }
    .cs-spine-hero-copy { min-height: 36rem; }
    .cs-spine-hero-index { margin-bottom: 0.7rem; }
    .cs-spine-title { max-width: 100%; font-size: clamp(2.65rem, 11.5vw, 3.15rem); line-height: 0.88; }
    .cs-spine-hero-foot,
    .cs-spine-heading-wrap,
    .cs-spine-principle,
    .cs-spine-metric,
    .cs-spine-contact { grid-template-columns: 1fr; }
    .cs-spine-hero-foot { gap: 1.25rem; }
    .cs-spine-section { padding: 3.7rem 0; }
    .cs-spine-heading-wrap { gap: 1rem; margin-bottom: 2.5rem; }
    .cs-spine-section-mark { padding-top: 0; }
    .cs-spine-heading-wrap h2 { font-size: clamp(2.55rem, 12.5vw, 4rem); }
    .cs-spine-lead { margin: 0 0 2.75rem; font-size: 1.2rem; }
