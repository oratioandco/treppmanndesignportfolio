---
import type { CaseStudy, CaseStudySection } from '../data/cv-tailor';

interface Props {
  study: CaseStudy;
  backUrl: string;
}

const { study, backUrl } = Astro.props;

const executiveSectionKeys = new Set(study.variants?.executive?.sections ?? []);
const hasExecutiveSelection = executiveSectionKeys.size > 0;
const isInExecutiveSelection = (section: CaseStudySection | undefined) => {
  if (!section) return false;
  if (!hasExecutiveSelection) return true;
  return executiveSectionKeys.has(section.type)
    || (!!section.headline && executiveSectionKeys.has(section.headline));
};

const hero = study.sections?.find((section: CaseStudySection) => section.type === 'hero');
const callout = study.sections?.find(
  (section: CaseStudySection) => section.type === 'callout' && isInExecutiveSelection(section)
);
const problem = study.sections?.find(
  (section: CaseStudySection) => section.type === 'narrative' && isInExecutiveSelection(section)
);
const solution = study.sections?.find(
  (section: CaseStudySection) => section.type === 'process' && isInExecutiveSelection(section)
);
const outcome = study.sections?.find(
  (section: CaseStudySection) => section.type === 'outcome' && isInExecutiveSelection(section)
);
const closer = [...(study.sections ?? [])]
  .reverse()
  .find((section: CaseStudySection) => section.content?.trim().endsWith('Get in touch.'));

const title = hero?.headline || study.title;
const titleAccent = 'LLM-safe';
const titleAccentIndex = title.toLowerCase().indexOf(titleAccent.toLowerCase());
const titleBefore = titleAccentIndex >= 0 ? title.slice(0, titleAccentIndex) : title;
const titleFocus = titleAccentIndex >= 0 ? title.slice(titleAccentIndex, titleAccentIndex + titleAccent.length) : '';
const titleAfter = titleAccentIndex >= 0 ? title.slice(titleAccentIndex + titleAccent.length) : '';
const projectArgument = hero?.subtext || study.subtitle;
const kicker = ['Case Study', study.company, study.duration].filter(Boolean).join(' · ').toUpperCase();
const closerLead = closer?.content?.replace(/\s*Get in touch\.\s*$/, '').trim() ?? '';
const closerHooks = splitParagraphs(closerLead);

function inlineStrong(text: string): string {
  return text.replace(/\*\*([^*\n]+?)\*\*/g, '<strong>$1</strong>');
}

function splitParagraphs(content: string | undefined): string[] {
  return (content ?? '')
    .split(/\n{2,}/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean);
}

// CSS balance improves the overall rag, but it does not guarantee that a
// display line will not end with one stranded word. Glue the final two words
// at render time so hero titles and pull quotes keep a deliberate closing line
// at every responsive width. The non-breaking spaces remain ordinary spaces to
// screen readers and do not change the source content.
function preventDisplayWidow(text: string, keepWords = 2): string {
  const words = text.trim().split(/\s+/).filter(Boolean);
  if (words.length <= 1) return text;
  const keep = Math.min(keepWords, words.length);
  const head = words.slice(0, -keep).join(' ');
  const tail = words.slice(-keep).join('\u00A0');
  return head ? `${head} ${tail}` : tail;
}

const problemParagraphs = splitParagraphs(problem?.content);
const problemLead = problemParagraphs[0] ?? '';
const problemRemainder = problemParagraphs.slice(1);
const problemConclusion = problemRemainder.at(-1) ?? '';
const problemDepth = problemRemainder.slice(0, -1);
const titleAfterDisplay = preventDisplayWidow(titleAfter);
---

<div class="cs-pilot-page">
  <header class="cs-pilot-hero cs-card">
    <canvas
      class="flow-canvas cs-pilot-field"
      data-slug={study.id}
      width="200"
      height="200"
      aria-hidden="true"
    ></canvas>

    <nav class="cs-pilot-nav" aria-label="Case study navigation">
      <a href={backUrl}>← Back to portfolio</a>
      <span>{kicker}</span>
      <a href="mailto:hello@treppmann.design">Get in touch</a>
    </nav>

    <div class="cs-pilot-hero-copy">
      <h1 id="cs-pilot-title" class="cs-pilot-title">
        {titleBefore}{titleFocus && <em>{titleFocus}</em>}{titleFocus && ' '}{titleAfterDisplay}
      </h1>
      <div class="cs-pilot-hero-foot">
        <div class="cs-pilot-meta">
          <p>{study.role}</p>
          {study.team && <span>{study.team}</span>}
        </div>
        {projectArgument && <p class="cs-pilot-argument">{projectArgument}</p>}
      </div>
    </div>
  </header>

  <main class="cs-pilot-article" aria-labelledby="cs-pilot-title">
    {callout?.quote && (
      <blockquote class="cs-pilot-principle">
        <p>{preventDisplayWidow(callout.quote)}</p>
        {callout.context && <footer>{callout.context}</footer>}
      </blockquote>
    )}

    {problem && (
      <section class="cs-pilot-section cs-pilot-problem" aria-labelledby="cs-pilot-problem">
        <div class="cs-pilot-heading-wrap">
          <span class="cs-pilot-section-mark" aria-hidden="true">The condition</span>
          <h2 id="cs-pilot-problem">{preventDisplayWidow(problem.headline)}</h2>
        </div>
        {problemLead && <p class="cs-pilot-lead" set:html={inlineStrong(problemLead)} />}

        <figure class="cs-pilot-evidence-figure">
          <a
            href="/images/bibeltv/llm-safe-storybook.png"
            class="cs-pilot-evidence-link"
            aria-label="Open the Storybook component-system screenshot at full size"
            target="_blank"
            rel="noreferrer"
          >
            <img
              src="/images/bibeltv/llm-safe-storybook.png"
              alt="Bibel TV Storybook showing the component library, theme and device controls, and a token inspector"
              loading="eager"
              decoding="async"
            />
            <span>View full size ↗</span>
          </a>
          <figcaption>The live system is the reference, not a handoff file.</figcaption>
        </figure>

        {problemDepth.length > 0 && (
          <details class="cs-pilot-depth">
            <summary>Why documentation was not enough</summary>
            <div class="cs-pilot-copy">
              {problemDepth.map((paragraph) => <p set:html={inlineStrong(paragraph)} />)}
            </div>
          </details>
        )}

        {problemConclusion && (
          <div class="cs-pilot-copy cs-pilot-problem-copy">
            <p set:html={inlineStrong(problemConclusion)} />
          </div>
        )}
      </section>
    )}

    {solution && (
      <section class="cs-pilot-section cs-pilot-solution" aria-labelledby="cs-pilot-solution">
        <div class="cs-pilot-heading-wrap">
          <span class="cs-pilot-section-mark" aria-hidden="true">The mechanism</span>
          <h2 id="cs-pilot-solution">{preventDisplayWidow(solution.headline)}</h2>
        </div>
        {solution.content && (
          <div class="cs-pilot-copy cs-pilot-solution-copy">
            {splitParagraphs(solution.content).map((paragraph) => <p set:html={inlineStrong(paragraph)} />)}
          </div>
        )}
        {solution.steps && (
          <ol class="cs-pilot-steps">
            {solution.steps.map((step, index) => (
              <li>
                <span class="cs-pilot-step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <h3>{step.label}</h3>
                <p>{step.description}</p>
              </li>
            ))}
          </ol>
        )}
      </section>
    )}

    {outcome && (
      <section class="cs-pilot-section cs-pilot-outcome" aria-labelledby="cs-pilot-outcome">
        <div class="cs-pilot-heading-wrap">
          <span class="cs-pilot-section-mark" aria-hidden="true">The proof</span>
          <h2 id="cs-pilot-outcome">{preventDisplayWidow(outcome.headline)}</h2>
        </div>
        {outcome.metrics && (
          <dl class="cs-pilot-metrics">
            {outcome.metrics.map((metric) => (
              <div class="cs-pilot-metric">
                <dt>{metric.label}</dt>
                {metric.value && <dd class="cs-pilot-metric-value">{metric.value}</dd>}
                {metric.before && metric.after && (
                  <dd class="cs-pilot-metric-change">
                    <span>{metric.before}</span>
                    <strong>{metric.after}</strong>
                  </dd>
                )}
              </div>
            ))}
          </dl>
        )}
      </section>
    )}

    {closer && (
      <section class="cs-pilot-contact" aria-labelledby="cs-pilot-contact-title">
        {closer.headline && <h2 id="cs-pilot-contact-title">{preventDisplayWidow(closer.headline)}</h2>}
        {closerHooks.length > 0 && (
          <ul class="cs-pilot-contact-hooks">
            {closerHooks.map((hook) => <li>{preventDisplayWidow(hook)}</li>)}
          </ul>
        )}
        <a href="mailto:hello@treppmann.design">Get in touch <span aria-hidden="true">↗</span></a>
      </section>
    )}
  </main>
</div>

<script>
  import '../scripts/flow-field-motifs.js';
</script>

<style is:global>
  .cs-pilot-page {
    --pilot-ink: #1a2520;
    --pilot-paper: #f4f1ea;
    --pilot-mint: #b9cdc4;
    padding-bottom: 3rem;
  }

  .cs-pilot-hero {
    position: relative;
    min-height: min(45rem, 80vh);
    overflow: hidden;
    padding: 0 clamp(1rem, 4vw, 4rem) clamp(2.5rem, 6vw, 5.5rem);
    color: var(--pilot-paper);
    background: var(--pilot-ink);
    isolation: isolate;
  }

  .cs-pilot-field {
    position: absolute;
    z-index: -2;
    top: 50%;
    right: -8%;
    width: min(72vw, 70rem);
    height: auto;
    aspect-ratio: 1;
    transform: translateY(-50%);
    opacity: 0.9;
    /* The motif is deliberately simulated on a 200×200 logical field.
       Nearest-neighbour scaling exposes that grid as a crisp material choice
       instead of letting the browser blur it into a low-resolution image. */
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }

  .cs-pilot-hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(92deg, var(--pilot-ink) 0%, var(--pilot-ink) 35%, rgba(26, 37, 32, 0.88) 50%, rgba(26, 37, 32, 0.12) 100%);
    pointer-events: none;
  }

  .cs-pilot-nav {
    min-height: 4.5rem;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid rgba(244, 241, 234, 0.22);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cs-pilot-nav a { color: var(--pilot-paper); text-decoration: none; }
  .cs-pilot-nav a:last-child { justify-self: end; border-bottom: 1px solid var(--pilot-mint); }
  .cs-pilot-nav span { color: var(--pilot-mint); text-align: center; }
  .cs-pilot-nav a:hover, .cs-pilot-nav a:focus-visible { color: var(--pilot-mint); }

  .cs-pilot-hero-copy {
    min-height: calc(min(45rem, 80vh) - 4.5rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .cs-pilot-title {
    max-width: 12.8ch;
    margin: clamp(3rem, 7vh, 5.5rem) 0 clamp(2rem, 4vh, 3rem);
    color: var(--pilot-paper);
    font-family: var(--font-body);
    font-size: clamp(3.6rem, 7.4vw, 7.4rem);
    font-style: normal;
    font-weight: 610;
    letter-spacing: -0.075em;
    line-height: 0.82;
    text-wrap: balance;
  }

  .cs-pilot-title em {
    color: var(--pilot-mint);
    font-family: var(--font-display-20);
    font-style: italic;
    font-weight: normal;
    letter-spacing: -0.035em;
  }

  .cs-pilot-hero-foot {
    display: grid;
    grid-template-columns: minmax(13rem, 0.7fr) minmax(25rem, 1.3fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
    border-top: 1px solid rgba(244, 241, 234, 0.22);
    padding-top: 1.2rem;
  }

  .cs-pilot-meta p, .cs-pilot-meta span {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    letter-spacing: 0.035em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .cs-pilot-meta span { display: block; max-width: 46ch; margin-top: 0.35rem; color: var(--pilot-mint); }
  .cs-pilot-argument { max-width: 53ch; margin: 0; color: #d7dfdb; font-size: clamp(1rem, 1.45vw, 1.25rem); line-height: 1.5; }

  .cs-pilot-article { max-width: 86rem; margin: 0 auto; padding: 0 clamp(1rem, 4vw, 4rem); }

  .cs-pilot-principle {
    display: grid;
    grid-template-columns: minmax(18rem, 1.15fr) minmax(16rem, 0.85fr);
    gap: clamp(2rem, 7vw, 8rem);
    align-items: end;
    margin: 0;
    padding: clamp(3rem, 6vw, 5rem) 0;
  }

  .cs-pilot-principle p {
    max-width: 15ch;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-display-20);
    font-size: clamp(2.8rem, 5.4vw, 5.25rem);
    font-style: italic;
    line-height: 0.82;
    letter-spacing: -0.035em;
    text-wrap: balance;
    orphans: 2;
    widows: 2;
  }

  .cs-pilot-principle footer { max-width: 40ch; padding-bottom: 0.55rem; color: var(--color-text-muted); font-size: 0.95rem; line-height: 1.55; }

  .cs-pilot-section { padding: clamp(3.5rem, 6vw, 5.5rem) 0; border-top: 1px solid var(--color-rule); }

  .cs-pilot-heading-wrap {
    display: grid;
    grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .cs-pilot-section-mark, .cs-pilot-step-number, .cs-pilot-metric dt, .cs-pilot-evidence-figure figcaption {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.065em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .cs-pilot-section-mark { padding-top: 0.7rem; color: var(--color-accent); }

  .cs-pilot-heading-wrap h2 {
    max-width: 18ch;
    margin: 0;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: clamp(2.7rem, 5.4vw, 5.4rem);
    font-style: normal;
    font-weight: 570;
    letter-spacing: -0.065em;
    line-height: 0.9;
    text-wrap: balance;
  }

  .cs-pilot-lead { max-width: 37ch; margin: 0 0 clamp(2.5rem, 5vw, 4rem) auto; color: var(--color-text); font-size: clamp(1.3rem, 2.2vw, 1.8rem); line-height: 1.35; }
  .cs-pilot-evidence-figure { width: min(88%, 66rem); margin: 0 0 clamp(2.5rem, 5vw, 4rem) auto; }
  .cs-pilot-evidence-link { position: relative; display: block; overflow: hidden; border: 1px solid var(--color-rule); background: var(--color-surface); }
  .cs-pilot-evidence-link span { position: absolute; right: 0.75rem; bottom: 0.75rem; padding: 0.45rem 0.6rem; color: var(--pilot-paper); background: rgba(26, 37, 32, 0.9); font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.05em; text-transform: uppercase; }
  .cs-pilot-evidence-figure img { display: block; width: 100%; height: auto; }
  .cs-pilot-evidence-figure figcaption { margin-top: 0.65rem; color: var(--color-text-muted); }

  .cs-pilot-copy { max-width: 39rem; color: var(--color-text); font-size: 1.02rem; line-height: 1.7; }
  .cs-pilot-copy p { margin: 0 0 1.25rem; }
  .cs-pilot-copy p:last-child { margin-bottom: 0; }
  .cs-pilot-problem-copy { margin-left: calc(32% + 2rem); }
  .cs-pilot-depth { max-width: 39rem; margin: 0 0 2rem calc(32% + 2rem); border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); }
  .cs-pilot-depth summary { padding: 0.9rem 0; color: var(--color-accent); font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.05em; text-transform: uppercase; cursor: pointer; }
  .cs-pilot-depth[open] summary { border-bottom: 1px solid var(--color-rule); }
  .cs-pilot-depth .cs-pilot-copy { padding: 1.25rem 0 1.5rem; }
  .cs-pilot-depth summary:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }
  .cs-pilot-solution { position: relative; }
  .cs-pilot-solution::before { content: ''; position: absolute; z-index: -1; inset: 0 50% 0 calc(50% - 50vw); background: var(--color-accent-light); }
  .cs-pilot-solution-copy { margin: 0 0 3.5rem calc(32% + 2rem); }

  .cs-pilot-steps { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--color-rule); }
  .cs-pilot-steps li {
    display: grid;
    grid-template-columns: 4rem minmax(12rem, 0.55fr) minmax(18rem, 1.45fr);
    gap: clamp(1.25rem, 4vw, 4rem);
    align-items: start;
    padding: 1.8rem 0 2rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .cs-pilot-step-number { color: var(--color-accent); }
  .cs-pilot-steps h3 { margin: 0; color: var(--color-text); font-family: var(--font-body); font-size: 1.08rem; font-style: normal; font-weight: 650; line-height: 1.35; }
  .cs-pilot-steps p { max-width: 58ch; margin: 0; color: var(--color-text); font-size: 0.95rem; line-height: 1.62; }

  .cs-pilot-metrics { margin: 0; }
  .cs-pilot-metric { display: grid; grid-template-columns: minmax(9rem, 0.32fr) minmax(0, 1.68fr); gap: clamp(2rem, 5vw, 5rem); padding: 1.7rem 0 2rem; border-top: 1px solid var(--color-rule); }
  .cs-pilot-metric dt { color: var(--color-accent); }
  .cs-pilot-metric dd { margin: 0; }
  .cs-pilot-metric-value { color: var(--color-accent); font-family: var(--font-display-20); font-size: 2rem; font-style: italic; }
  .cs-pilot-metric-change { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2rem, 5vw, 5rem); line-height: 1.5; }
  .cs-pilot-metric-change span { color: var(--color-text-muted); font-weight: 430; }
  .cs-pilot-metric-change strong { position: relative; color: var(--color-text); font-weight: 560; }
  .cs-pilot-metric-change strong::before { content: '↳'; position: absolute; left: -1.5rem; color: var(--color-accent); font-family: var(--font-mono); font-weight: normal; }

  .cs-pilot-contact {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    padding: clamp(3.5rem, 6vw, 6rem) 0 1rem;
    border-top: 1px solid var(--color-rule);
  }
  .cs-pilot-contact h2 { margin: 0; color: var(--color-text); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 560; letter-spacing: 0.08em; line-height: 1.2; text-transform: uppercase; }
  .cs-pilot-contact-hooks { margin: 0; padding: 0; list-style: none; }
  .cs-pilot-contact-hooks li { max-width: 54ch; padding: 1rem 0 1.25rem; border-top: 1px solid var(--color-rule); color: var(--color-text); font-family: var(--font-display-20); font-size: clamp(1.45rem, 2.4vw, 2.35rem); font-style: italic; letter-spacing: -0.02em; line-height: 1.08; text-wrap: pretty; orphans: 2; widows: 2; }
  .cs-pilot-contact-hooks li:last-child { border-bottom: 1px solid var(--color-rule); }
  .cs-pilot-contact a { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 2rem; padding: 0.8rem 0; border-top: 1px solid var(--color-accent); border-bottom: 1px solid var(--color-accent); color: var(--color-text); font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.04em; text-decoration: none; text-transform: uppercase; }
  .cs-pilot-contact a:hover { color: var(--color-accent); }

  .cs-pilot-nav a:focus-visible, .cs-pilot-evidence-link:focus-visible, .cs-pilot-contact a:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 4px; }

  @media (max-width: 64rem) {
    .cs-pilot-hero { min-height: 44rem; }
    .cs-pilot-title { max-width: 13ch; }
    .cs-pilot-field { right: -26%; width: 80vw; }
    .cs-pilot-problem-copy, .cs-pilot-solution-copy, .cs-pilot-depth { margin-left: 0; }
    .cs-pilot-steps li { grid-template-columns: 3rem minmax(10rem, 0.6fr) minmax(16rem, 1.4fr); gap: 1.5rem; }
  }

  @media (max-width: 48rem) {
    .cs-pilot-page { padding-bottom: 3rem; }
    .cs-pilot-hero { min-height: 41rem; padding: 0 1rem 2rem; }
    .cs-pilot-field { top: 6rem; right: -55%; width: 150vw; height: auto; transform: none; opacity: 0.7; }
    .cs-pilot-hero::after { background: linear-gradient(180deg, rgba(26, 37, 32, 0.16) 0%, rgba(26, 37, 32, 0.7) 42%, var(--pilot-ink) 72%); }
    .cs-pilot-nav { min-height: 4rem; grid-template-columns: 1fr auto; gap: 1rem; }
    .cs-pilot-nav > span { display: none; }
    .cs-pilot-hero-copy { min-height: 37rem; }
    .cs-pilot-title { margin: 5rem 0 2.5rem; font-size: clamp(3.15rem, 16vw, 5rem); line-height: 0.86; }
    .cs-pilot-hero-foot, .cs-pilot-principle, .cs-pilot-heading-wrap, .cs-pilot-metric, .cs-pilot-contact { grid-template-columns: 1fr; }
    .cs-pilot-hero-foot { gap: 1.25rem; }
    .cs-pilot-principle { gap: 2rem; padding: 3.5rem 0; }
    .cs-pilot-principle p { font-size: clamp(2.8rem, 13vw, 4.2rem); }
    .cs-pilot-section { padding: 3.5rem 0; }
    .cs-pilot-heading-wrap { gap: 1rem; margin-bottom: 2.5rem; }
    .cs-pilot-section-mark { padding-top: 0; }
    .cs-pilot-heading-wrap h2 { font-size: clamp(2.7rem, 13vw, 4.2rem); }
    .cs-pilot-lead { margin: 0 0 3rem; font-size: 1.25rem; }
    .cs-pilot-evidence-figure { width: calc(100% + 2rem); margin: 0 -1rem 3rem; overflow-x: auto; }
    .cs-pilot-evidence-link { width: 42rem; }
    .cs-pilot-evidence-figure figcaption { padding-left: 1rem; }
    .cs-pilot-steps li { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.75rem 1rem; }
    .cs-pilot-steps h3, .cs-pilot-steps p { grid-column: 2; }
    .cs-pilot-metric { gap: 1rem; }
    .cs-pilot-metric-change { grid-template-columns: 1fr; gap: 1rem; }
    .cs-pilot-metric-change strong { padding-left: 1.5rem; }
    .cs-pilot-metric-change strong::before { left: 0; }
    .cs-pilot-contact { gap: 2.5rem; padding-top: 4rem; }
