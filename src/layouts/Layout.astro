---

interface Props {
  title: string;
  description?: string;
  showBackButton?: boolean;
  backUrl?: string;
  backLabel?: string;
}

const { title, description = "AI-Native Product & Design Leader — the design leader moving closer to the model", showBackButton = false, backUrl = "/", backLabel = "← Back" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Tobias Treppmann</title>
    <script is:inline>
      // Set theme BEFORE first paint to avoid FOUC.
      // Dark when it's night in Berlin (19:00-07:00) OR device prefers dark.
      (function () {
        let h;
        try {
          h = parseInt(
            new Date().toLocaleString("en-US", {
              hour: "2-digit",
              hour12: false,
              timeZone: "Europe/Berlin",
            }),
            10,
          );
        } catch (e) {
          h = new Date().getHours();
        }
        const isNight = !isNaN(h) && (h < 7 || h >= 19);
        const deviceDark =
          window.matchMedia &&
          window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (isNight || deviceDark) {
          document.documentElement.setAttribute("data-theme", "dark");
        }
        // React to OS-level dark-mode toggle
        if (window.matchMedia) {
          window
            .matchMedia("(prefers-color-scheme: dark)")
            .addEventListener("change", function (e) {
              const hh = parseInt(
                new Date().toLocaleString("en-US", {
                  hour: "2-digit",
                  hour12: false,
                  timeZone: "Europe/Berlin",
                }),
                10,
              );
              const night = !isNaN(hh) && (hh < 7 || hh >= 19);
              if (night || e.matches) {
                document.documentElement.setAttribute("data-theme", "dark");
              } else {
                document.documentElement.removeAttribute("data-theme");
              }
            });
        }
        // Re-check time every 5 minutes for natural day/night transitions
        setInterval(function () {
          const hh = parseInt(
            new Date().toLocaleString("en-US", {
              hour: "2-digit",
              hour12: false,
              timeZone: "Europe/Berlin",
            }),
            10,
          );
          const night = !isNaN(hh) && (hh < 7 || hh >= 19);
          const dDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (night || dDark) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
        }, 300000);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    {showBackButton && (
      <div class="back-button-container">
        <div class="container">
          <a href={backUrl} class="back-button">{backLabel}</a>
        </div>
      </div>
    )}

    <main>
      <slot />
    </main>

    <script is:inline>
      // Scroll reveals. See the MOTION block in global.css for the three rules
      // this implements; the important one is that `.js-motion` is added HERE,
      // at runtime, so a parse error or a blocked script leaves the page
      // visible rather than blank.
      (function () {
        function initReveals() {
          var root = document.documentElement;
          if (!('IntersectionObserver' in window)) return;
          root.classList.add('js-motion');

          // Grouped so stagger restarts per group — a single document-order
          // index would give the last card on a long page a 2-second delay.
          var groups = [
            '.case-studies-grid > *',
            '.section-header',
            '.cs-section',
            '.practice-item',
            '.hero-bio',
          ];

          var targets = [];
          groups.forEach(function (sel) {
            var found = document.querySelectorAll(sel);
            for (var i = 0; i < found.length; i++) {
              var el = found[i];
              if (el.hasAttribute('data-reveal')) continue;
              el.setAttribute('data-reveal', '');
              // Cap the stagger: past the fourth item a visitor reads it as lag.
              el.style.setProperty('--reveal-delay', Math.min(i, 4) * 70 + 'ms');
              targets.push(el);
            }
          });

          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target); // reveal once, never re-hide
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );

          targets.forEach(function (el) {
            // Anything already in view on load reveals immediately, so the
            // first screen is never waiting on a scroll that may not come.
            var box = el.getBoundingClientRect();
            if (box.top < window.innerHeight * 0.92) {
              el.classList.add('is-revealed');
            } else {
              io.observe(el);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveals);
        } else {
          initReveals();
        }
        // Re-run after a client-side navigation (Astro ClientRouter).
        document.addEventListener('astro:page-load', initReveals);
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
