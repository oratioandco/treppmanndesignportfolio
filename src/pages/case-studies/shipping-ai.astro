---
/**
 * Shipping AI, Not Designing Around It — the flagship case study.
 *
 * Content from handover/PORTFOLIO-CONTENT-AND-PROMPT.md Part 1, using the
 * FACT-CHECKED copy in that file rather than the earlier draft. Two claims
 * differ between the two versions and the corrected ones are used here:
 *   - "Over a year" at Bibel TV, not "over eighteen months" (mid-Aug 2025 to
 *     now is ~12 months elapsed, ~15 over the full contract).
 *   - The campaign generator's web prototype is INTERNAL. Only the skill's
 *     outputs reach customer surfaces. Nothing here says otherwise.
 *
 * The /for/ VARIANT paragraph in the handover is deliberately NOT used: it is
 * scoped to application pages, and this is treppmann.design.
 */
import { readdirSync, existsSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import SummaryBand from '../../components/SummaryBand.astro';

/**
 * Copilot screenshots, read from disk at build time so dropping files into
 * public/images/bibeltv/copilot/ is the whole job. Spec and the reasoning for
 * which frames are used live in data/case-studies/screenshots-bibeltv-copilot.md
 * over in my-cv-tailor.
 *
 * Alt text is mapped from the filenames that spec asks for. Anything else gets
 * a plain fallback and should be given real alt text here once seen.
 */
const SHOT_DIR = 'public/images/bibeltv/copilot';
const SHOT_META: Record<string, { alt: string; caption?: string }> = {
  'copilot-home.png': {
    alt: 'The Zuschauerservice Assistent start screen, created by Tobias Treppmann, with starter prompts for donation thanks, returns and magazine cancellations',
    caption: 'The agent in Microsoft 365. The three starters are the everyday traffic of a viewer-services desk.',
  },
  'copilot-bereavement.png': {
    alt: 'The copilot answering a request to cancel a programme magazine after a death, with condolence and the administrative action',
    caption: 'A bereavement notice answered in house voice. Bereavement is not what the tool treats as crisis: crisis means acute risk to the person writing, and those are never drafted at all.',
  },
  'copilot-escalation.png': {
    alt: 'The copilot declining to draft a reply and flagging the message for a person instead',
    caption: 'The tool refusing to answer. Escalation is a first-class output, not an error state.',
  },
  'copilot-complex.png': {
    alt: 'The copilot answering a viewer letter that raises several separate complaints at once',
    caption: 'Four threads in one letter. This is the shape that used to cost an agent hours.',
  },
};

const shots = existsSync(SHOT_DIR)
  ? readdirSync(SHOT_DIR)
      .filter((f) => /\.(png|jpe?g|webp|avif)$/i.test(f))
      .sort()
      .map((f) => ({
        src: `/images/bibeltv/copilot/${f}`,
        alt: SHOT_META[f]?.alt ?? 'The copilot interface',
        caption: SHOT_META[f]?.caption,
      }))
  : [];
---

<Layout
  title="Shipping AI, Not Designing Around It"
  description="A support copilot in daily use, a campaign generation tool built end to end, and a prototyping practice engineering builds from directly."
  showBackButton={true}
>
  <section class="case-study-hero">
    <div class="container">
      <p class="case-study-meta">AI Product &amp; Practice</p>
      <h1>Shipping AI, Not Designing Around It</h1>
      <p class="hero-tagline">Bibel TV</p>
      <p class="hero-description">
        Most design leaders in 2026 can talk about AI. Over a year at a
        broadcaster mid linear-to-streaming transformation, I moved from
        designing <em>for</em> the model to shipping production AI myself: a support copilot in daily use, a
        campaign generation tool built end to end, and a prototyping
        practice engineering now builds from directly.
      </p>
    </div>
  </section>

  <SummaryBand
    figures={[
      { value: "~70%", label: "Of AI-generated code ships" },
      { value: "Hours", label: "Iteration, down from days" },
      { value: "4", label: "Platforms" }
    ]}
    meta="Head of Product Design · Bibel TV · agentic engineering practice"
  />

  <section class="case-study-content">
    <div class="container content content--hanging">
      <section class="cs-section">
        <h2 class="cs-section__heading">The support copilot</h2>
        <div class="cs-section__body">
      <p>
        The viewer-services team answers letters, emails and social
        messages. They are often long, often emotional, sometimes in
        crisis. I built them a copilot: paste in the message, get a draft
        grounded in the service handbook, in its wording, its formatting
        and its standard phrases.
      </p>
      <p>
        Three decisions defined it. Restricted-topic rules are enforced
        <em>in the output</em>, not left to the agent to remember. Crisis messages never get drafted at all; they escalate to a
        person. Every send decision stays human, and the tool never sends.
      </p>
      <p>
        Rollout was designed as carefully as the tool. I tested it on myself first, then ran one-on-ones. No group demo,
        no mandate. It stayed fully optional, with the team lead asking
        only that people try it and share feedback. It then earned its
        place on the hard cases rather than the easy ones. One of the most
        sceptical senior agents tried it on a letter that would normally
        cost hours, carrying multiple parallel topics and strongly argued
        criticism, and shipped a good response in minutes.
      </p>
      <p>
        <strong>Where it landed:</strong> complex multi-topic letters answered in
        minutes instead of hours. Temporary staff write in the company's voice
        from day one. The sceptics use it daily and told me so unprompted.
      </p>
      {shots.length > 0 && (
        <div class="cs-figures">
          {shots.map((s) => (
            <figure class="cs-figure">
              <img src={s.src} alt={s.alt} loading="lazy" />
              {s.caption && <figcaption>{s.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
        </div>
      </section>

      <section class="cs-section">
        <h2 class="cs-section__heading">The companion campaign generator</h2>
        <div class="cs-section__body">
      <p>
        Bibel TV runs bi-monthly fundraising campaigns. Each one needs
        supporting material across several formats: in-app notifications,
        web banners, short video scripts. All of it carries the same
        message in the same voice, and it is produced under time pressure
        by people who aren't copywriters.
      </p>
      <p>
        I built a web application that generates them. The generation
        itself is straightforward. The work was in what it reasons from.
        Three things became the system's context: the organisation's
        formatting guidelines, its accumulated fundraising knowledge, much
        of it previously held in people's heads rather than written down,
        and its house voice. The interaction is a multi-turn clarifying-question loop rather
        than single-shot prompting. The tool asks what it needs to know
        about the campaign before producing anything, which is what makes
        the output usable rather than merely fast.
      </p>
      <p>
        Analysis, prompt architecture, prototype, production skill. No
        engineering hand-off at any stage.
      </p>
      <blockquote class="pull-statement">
        The institutional knowledge was always the asset. AI just made it
        addressable.
      </blockquote>
      <p>
        That's the pattern across both systems. Neither tool is clever on its
        own. Each works because the organisation's own knowledge became the
        context the model reasons from: the service handbook, the
        fundraising guidelines, the things people knew but had never
        written down.
      </p>
        </div>
      </section>

      <section class="cs-section">
        <h2 class="cs-section__heading">Agentic engineering as design practice</h2>
        <div class="cs-section__body">
      <p>
        I stopped shipping specs. The new experience was designed first as a
        working web prototype, then as an Android prototype, both built with
        AI-assisted coding against real production APIs. Engineering now consumes that prototype code directly. Roughly 70%
        of it reaches production with minor modification, and iteration
        collapsed from days of spec-and-handoff to hours in working code.
      </p>
        </div>
      </section>

      <section class="cs-section">
        <h2 class="cs-section__heading">The design system as an API</h2>
        <div class="cs-section__body">
      <p>
        One token repository on the DTCG standard, with three tiers
        running from global primitives through semantic to component.
        Built with Style Dictionary and synced live to Figma and Android,
        with iOS and web ready, architected to support server-driven UI. One commit propagates to every platform.
        Consistency enforced by structure rather than coordination.
      </p>
        </div>
      </section>

      <section class="cs-section">
        <h2 class="cs-section__heading">What made it work</h2>
        <div class="cs-section__body">
      <p class="closing-note">
        Nobody was told to use any of this. The copilot went out optional, with
        the team lead asking people to try it rather than requiring it. I tested
        it on myself before anyone else saw it. It reached the team on hard cases
        first: the most sceptical agent's worst letter, not a tidy demo. That
        sequence is slower than a rollout plan, and it is the part I would
        repeat.
      </p>
        </div>
      </section>
</div>
  </section>
</Layout>

<style>
  /* Pull statement — Gambarino italic, breaking the measure deliberately
     (case-study design spec §2). Hanging opening quote, per §5. */
  .pull-statement {
    font-family: "Gambarino", Georgia, serif;
    font-style: italic;
    font-size: 2rem;
    line-height: 1.28;
    margin: 3.5rem 0 3.5rem -1.5rem;
    padding: 0;
    border: none;
    color: var(--color-text);
    max-width: 22ch;
  }

  /* The literal glyph, not an escape. This was `"\\201C"`, which CSS reads as
     an escaped backslash followed by the text 201C — so the page rendered a
     visible \201C in front of the quote. `\201C` would also work; the character
     itself cannot be got wrong. */
  .pull-statement::before {
    content: "“";
    margin-left: -0.5em;
  }

  /* Closing note — the honest limitation, indented and italic per §3. */
  .closing-note {
    font-style: italic;
    margin-left: 2rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 760px) {
    .pull-statement {
      font-size: 1.5rem;
      margin-left: 0;
      max-width: none;
    }
    .pull-statement::before {
      margin-left: 0;
    }
    .closing-note {
      margin-left: 0;
    }
  }
</style>
