---
import Layout from '../layouts/Layout.astro';
import BioRegenerator from '../components/BioRegenerator.astro';
import Portrait from '../components/Portrait.astro';
import Selah from '../components/Selah.astro';
import DotField from '../components/DotField.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
---

<Layout title="AI-Native Product & Design Leader">
  <section class="hero">
    <DotField />
    <div class="container">
      <p class="hero-tagline">AI-Native Product &amp; Design Leader</p>
      <h1 class="animated-headline" id="animated-title">The design leader moving closer to the model</h1>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  const text = title.textContent;

  // Wrap each letter in a span
  title.innerHTML = text.split('').map((char, i) =>
    char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
  ).join('');

  const letters = title.querySelectorAll('.letter');

  // Each letter gets its own random behavior
  letters.forEach((letter) => {
    let currentFontIndex = Math.floor(Math.random() * fonts.length);
    letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;

    const animate = () => {
      // Random jump to any font (not just neighbors)
      const newIndex = Math.floor(Math.random() * fonts.length);
      currentFontIndex = newIndex;
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;

      // Random interval between 1500-4000ms per change
      const nextInterval = 1500 + Math.random() * 2500;
      setTimeout(animate, nextInterval);
    };

    // Random start delay between 0-5000ms
    const delay = Math.random() * 5000;
    setTimeout(animate, delay);
  });
</script>
      <div class="hero-bio">
        <Portrait
          alt="Tobias Treppmann, photographed on a Berlin rooftop, a church tower out of focus behind him"
        />
        <div class="hero-bio__text">
          <BioRegenerator />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-header">
        <h2>Case Studies</h2>
        <p class="text-muted">Recent work demonstrating hands-on leadership and technical depth</p>
      </div>

      <div class="case-studies-grid">
        <CaseStudyCard
          href="/case-studies/llm-safe-design-system"
          headline="An LLM-Safe Design System"
          caption="Design Systems & Governance"
          studyId="bibeltv-llm-safe-design-system"
        />
        <CaseStudyCard
          href="/case-studies/shipping-ai"
          headline="Shipping AI, Not Designing Around It"
          caption="AI Product & Practice"
          studyId="shipping-ai"
        />
        <CaseStudyCard
          href="/case-studies/churchdesk"
          headline="When 'Simple Booking' Isn't Simple"
          caption="ChurchDesk Booking System"
          studyId="churchdesk-booking-system"
        />
        <CaseStudyCard
          href="/case-studies/collaboration-redesign"
          headline="Redesigning How We Work Together"
          caption="Leadership & Team Systems"
          studyId="leading-a-team-is-a-design-problem"
        />
        <CaseStudyCard
          href="/case-studies/modern-practice"
          headline="Accelerating Design with AI"
          caption="AI-First Design Process"
          studyId="bibeltv-ai-prototyping"
        />
      </div>
    </div>
  </section>

  <Selah />
</Layout>
