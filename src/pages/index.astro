---
// The site root is the commercial front door since 2026-10-21: the course
// first, then engagements, then a short run of work. The portfolio that used
// to live here is /work, and the tailored /work/for/ pages never link back to
// this page, so a hiring manager reading an application never lands on an
// offer by accident.
//
// Prices live on /learn only. SAL-002 (check-public-output.mjs) fails the
// build on any currency amount outside the price-list pages.
import Layout from '../layouts/Layout.astro';
import DotField from '../components/DotField.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getAllPublicCaseStudies, type CaseStudy, type CaseStudySection } from '../data/cv-tailor';

const FEATURED_IDS = [
  'bibeltv-llm-safe-design-system',
  'bibeltv-ai-prototyping',
];

const allStudies = getAllPublicCaseStudies();
const featuredStudies = FEATURED_IDS
  .map((id) => allStudies.find((s) => s.id === id))
  .filter((s): s is CaseStudy => !!s);

function cardProps(study: CaseStudy) {
  const heroSection = study.sections?.find((s: CaseStudySection) => s.type === 'hero');
  return {
    href: `/work/${study.id}`,
    headline: heroSection?.headline || study.title,
    caption: [study.company, study.duration].filter(Boolean).join(' · '),
    studyId: study.id,
    cover: study.cover,
  };
}

const STAGES = [
  { label: 'Foundations', topics: 'Choosing models, prototyping on real APIs and data, research analysis at scale' },
  { label: 'Building', topics: 'Your first iOS app, your first cross-platform app, working in code with agents' },
  { label: 'Systems', topics: 'Design systems agents can use safely, your own MCP server, evaluating AI features' },
];

const ENGAGEMENTS = [
  {
    title: 'AI design sprint',
    length: '1–2 weeks',
    body: 'From a product question to a working prototype on your real API and data, tested with users and handed to engineering as code.',
  },
  {
    title: 'Fractional design leadership',
    length: '1–2 days a week',
    body: 'Design direction, critique and hiring support, plus setting up how your designers and engineers work with AI day to day.',
  },
  {
    title: 'Design system check',
    length: 'About a week',
    body: 'Does your design system hold when AI generates the interface? A review of tokens, component contracts and the CI checks that catch drift before it ships.',
    link: { href: '/work/bibeltv-llm-safe-design-system', label: 'How this works at Bibel TV' },
  },
  {
    title: 'Training and coaching',
    length: 'Single session or retainer',
    body: 'Workshops, 1:1 coaching and sparring for designers adding AI to their practice. Also available as a retainer with office hours.',
  },
];

const MAIL = 'hello@treppmann.design';
const engagementMail = `mailto:${MAIL}?subject=${encodeURIComponent('Engagement inquiry')}`;
---

<Layout
  title="AI for Product Designers"
  description="Courses and engagements for product designers and design teams who want to build with real models, APIs and data."
>
  <section class="hero hero--editorial">
    <DotField spacing={24} />
    <div class="container">
      <nav class="site-rail" aria-label="Site navigation">
        <a href="/">Tobias Treppmann</a>
        <span>Berlin · AI for product design</span>
        <a href={`mailto:${MAIL}`}>Get in touch</a>
      </nav>

      <div class="editorial-hero__mast">
        <p class="hero-tagline">Courses &amp; engagements</p>
        <h1 class="animated-headline" id="animated-title">Design closer to the model</h1>
      </div>

      <div class="editorial-hero__profile home-hero__lede">
        <p class="home-hero__kicker">For product designers and design teams</p>
        <p>
          A growing course library for working product designers, and hands-on
          engagements for teams that design and build with AI in production.
          Taught by a Head of Product Design whose prototypes are the code
          engineering builds from.
        </p>
      </div>

      <div class="editorial-hero__actions">
        <a href="/learn">The course <span aria-hidden="true">→</span></a>
        <a href="#engagements">Work with me <span aria-hidden="true">↓</span></a>
      </div>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  if (title) {
    const text = title.textContent || '';
    title.innerHTML = text.split('').map((char, i) =>
      char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
    ).join('');
    const letters = title.querySelectorAll('.letter');
    letters.forEach((letter) => {
      let currentFontIndex = Math.floor(Math.random() * fonts.length);
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
      const animate = () => {
        currentFontIndex = Math.floor(Math.random() * fonts.length);
        letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
        setTimeout(animate, 1500 + Math.random() * 2500);
      };
      setTimeout(animate, Math.random() * 5000);
    });
  }
</script>
    </div>
  </section>

  <section class="section" id="course">
    <div class="container">
      <div class="section-header">
        <h2>Closer to the Model</h2>
        <p class="text-muted">
          Short, project-based courses for mid-level, senior and lead product
          designers. Each one ends with something you built: a prototype on a
          live API, an analyzed research set, an app on your phone.
        </p>
      </div>

      <ol class="offer-list">
        {STAGES.map((stage, i) => (
          <li class="offer-item">
            <p class="offer-item__meta">Stage {i + 1}</p>
            <h3>{stage.label}</h3>
            <p>{stage.topics}</p>
          </li>
        ))}
      </ol>

      <p class="offer-cta">
        <a class="btn btn--solid" href="/learn">Founding membership</a>
        <span class="text-muted">Single modules, or lifetime access to the whole library as it grows.</span>
      </p>
    </div>
  </section>

  <section class="section" id="engagements">
    <div class="container">
      <div class="section-header">
        <h2>Engagements</h2>
        <p class="text-muted">
          For product and design leaders who want their team designing with AI
          in real products. Scope and price are agreed before we start.
        </p>
      </div>

      <ul class="offer-list offer-list--two">
        {ENGAGEMENTS.map((e) => (
          <li class="offer-item">
            <p class="offer-item__meta">{e.length}</p>
            <h3>{e.title}</h3>
            <p>{e.body}</p>
            {e.link && <p><a href={e.link.href}>{e.link.label} <span aria-hidden="true">→</span></a></p>}
          </li>
        ))}
      </ul>

      <p class="offer-cta">
        <a class="btn btn--solid" href={engagementMail}>Start a conversation</a>
      </p>
    </div>
  </section>

  {featuredStudies.length > 0 && (
    <section class="section" id="case-studies">
      <div class="container">
        <div class="section-header">
          <h2>Selected work</h2>
          <p class="text-muted">The practice the course and the engagements come from.</p>
        </div>

        <div class="case-studies-grid">
          {featuredStudies.map((study) => {
            const c = cardProps(study);
            return <CaseStudyCard href={c.href} headline={c.headline} caption={c.caption} studyId={c.studyId} cover={c.cover} />;
          })}
        </div>

        <p class="offer-cta">
          <a class="btn" href="/work">All work</a>
        </p>
      </div>
    </section>
  )}

  <section class="section" id="about">
    <div class="container">
      <div class="section-header">
        <h2>Tobias Treppmann</h2>
        <p class="text-muted">
          Head of Product Design at Bibel TV, where engineering builds from his
          prototype code and the design system carries CI checks for
          AI-generated interfaces. Before that, ten years of 1:1 mentoring at
          CareerFoundry, guiding more than 100 career changers into UX design.
          Based in Berlin.
        </p>
      </div>
      <p class="offer-cta">
        <a class="btn" href="/about">About</a>
        <a class="btn" href={`mailto:${MAIL}`}>{MAIL}</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .home-hero__lede {
    color: #d7dfdb;
  }

  .home-hero__lede p {
    max-width: 58ch;
    margin: 0;
  }

  .home-hero__lede .home-hero__kicker {
    color: #a4c6b9;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offer-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .offer-list--two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .offer-item {
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  .offer-item h3 {
    margin: 0.25rem 0 0.75rem;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    line-height: 1.1;
  }

  .offer-item p {
    margin: 0;
    max-width: 48ch;
  }

  .offer-item p + p {
    margin-top: 0.75rem;
  }

  .offer-item__meta {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .offer-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (max-width: 760px) {
    .offer-list,
    .offer-list--two {
      grid-template-columns: 1fr;
    }
  }
</style>
