---
import Layout from '../layouts/Layout.astro';
import BioRegenerator from '../components/BioRegenerator.astro';
import Portrait from '../components/Portrait.astro';
import DotField from '../components/DotField.astro';
---

<Layout title="AI-Native Product & Design Leader">
  <section class="hero">
    <DotField />
    <div class="container">
      <p class="hero-tagline">AI-Native Product &amp; Design Leader</p>
      <h1 class="animated-headline" id="animated-title">The design leader moving closer to the model</h1>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  const text = title.textContent;

  // Wrap each letter in a span
  title.innerHTML = text.split('').map((char, i) =>
    char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
  ).join('');

  const letters = title.querySelectorAll('.letter');

  // Each letter gets its own random behavior
  letters.forEach((letter) => {
    let currentFontIndex = Math.floor(Math.random() * fonts.length);
    letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;

    const animate = () => {
      // Random jump to any font (not just neighbors)
      const newIndex = Math.floor(Math.random() * fonts.length);
      currentFontIndex = newIndex;
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;

      // Random interval between 1500-4000ms per change
      const nextInterval = 1500 + Math.random() * 2500;
      setTimeout(animate, nextInterval);
    };

    // Random start delay between 0-5000ms
    const delay = Math.random() * 5000;
    setTimeout(animate, delay);
  });
</script>
      <div class="hero-bio">
        <Portrait
          alt="Tobias Treppmann, photographed on a Berlin rooftop, a church tower out of focus behind him"
        />
        <div class="hero-bio__text">
          <BioRegenerator />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-header">
        <h2>Case Studies</h2>
        <p class="text-muted">Recent work demonstrating hands-on leadership and technical depth</p>
      </div>

      <div class="case-studies-grid">
        <a href="/case-studies/shipping-ai" class="case-study-card">
          <img src="/images/covers/generated/bibeltv-agentic-engineering.svg" alt="Shipping AI, Not Designing Around It" class="case-study-cover" />
          <h3>Shipping AI, Not Designing Around It</h3>
          <p class="subtitle">AI Product &amp; Practice</p>
          <p>A support copilot in daily use, a campaign generation tool built end to end, and a prototyping practice engineering builds from directly.</p>
          <div style="margin-top: var(--space-md);">
            <span class="tag">AI in Production</span>
            <span class="tag">Agentic Engineering</span>
            <span class="tag">Design System as API</span>
          </div>
        </a>

        <a href="/case-studies/churchdesk" class="case-study-card">
          <img src="/images/covers/generated/churchdesk-booking-system.svg" alt="ChurchDesk Booking System" class="case-study-cover" />
          <h3>When 'Simple Booking' Isn't Simple</h3>
          <p class="subtitle">ChurchDesk Booking System</p>
          <p>Designing a deceptively simple booking experience that masks extraordinary complexity—multi-stakeholder coordination for sensitive contexts.</p>
          <div style="margin-top: var(--space-md);">
            <span class="tag">Complex Systems</span>
            <span class="tag">Multi-stakeholder</span>
            <span class="tag">Platform Design</span>
          </div>
        </a>

        <a href="/case-studies/collaboration-redesign" class="case-study-card">
          <img src="/images/covers/generated/leading-a-team-is-a-design-problem.svg" alt="Leadership & Team Systems" class="case-study-cover" />
          <h3>Redesigning How We Work Together</h3>
          <p class="subtitle">Leadership & Team Systems</p>
          <p>When collaboration keeps breaking down, the instinct is to manage the person. Usually the person is fine and the working conditions are the defect.</p>
          <div style="margin-top: var(--space-md);">
            <span class="tag">Leadership</span>
            <span class="tag">Team Design</span>
            <span class="tag">Systems</span>
          </div>
        </a>

        <a href="/case-studies/modern-practice" class="case-study-card">
          <img src="/images/covers/generated/bibeltv-ai-prototyping.svg" alt="AI-First Design Process" class="case-study-cover" />
          <h3>Accelerating Design with AI</h3>
          <p class="subtitle">AI-First Design Process</p>
          <p>AI compresses the path from idea to testable prototype. Developing an AI-first design process at Bibel TV and teaching teams to do the same.</p>
          <div style="margin-top: var(--space-md);">
            <span class="tag">Claude Code</span>
            <span class="tag">Zed/VSCode</span>
            <span class="tag">AI Prototyping</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="practice">
    <div class="container">
      <div class="section-header">
        <h2>Also</h2>
      </div>
      <div class="selah">
        <div class="selah__text">
          <h3>Selah</h3>
          <p class="selah__meta">Shipped on the Mac App Store &middot; designed and built solo</p>
          <p>
            A leadership tool: 60&ndash;90 second structured transitions between
            meetings, so you arrive present rather than carrying the last
            conversation into the next one. It started as my own calendar hack.
            I did the product, the interface, the build, the icon and the store
            listing.
          </p>
          <p class="selah__links">
            <a class="btn" href="https://selah.guide" rel="noopener">selah.guide</a>
          </p>
        </div>
        <div class="selah__shots" aria-hidden="true">
          <!-- Screenshot slots. Deliberately empty rather than filled with a
               placeholder graphic: an empty frame reads as unfinished, a fake
               one reads as dishonest, and this is the one artifact on the site
               that needs nobody's approval to photograph. See
               data/case-studies/screenshots-selah.md for what to capture. -->
        </div>
      </div>
    </div>
  </section>
</Layout>
