---
import Layout from '../../../layouts/Layout.astro';
import NarrativeSpineCaseStudy from '../../../components/NarrativeSpineCaseStudy.astro';
import {
  getAllFilters,
  getFilterPaths,
  getFilterWithStudies,
} from '../../../data/cv-tailor';

export function getStaticPaths() {
  const filters = getAllFilters();
  const paths = [];

  for (const filter of filters) {
    const data = getFilterWithStudies(filter.slug);
    if (!data) continue;

    for (const study of data.studies) {
      if (study.visibility === 'hidden') continue;
      // One path per alias too, so a scoped case-study link inside an
      // already-published /for/ page keeps resolving after a slug change.
      for (const slug of getFilterPaths(filter)) {
        paths.push({
          params: { slug, study: study.id },
          props: { filter, study },
        });
      }
    }
  }
  return paths;
}

const { filter, study } = Astro.props;
const backUrl = `/for/${filter.slug}`;

const heroSection = study.sections?.find((s: any) => s.type === 'hero');
const pageTitle = heroSection?.headline || study.title;
const pageDescription = study.subtitle || '';
---
<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
</Fragment>


<Layout title={pageTitle} description={pageDescription}>
  <NarrativeSpineCaseStudy study={study} backUrl={backUrl} />
</Layout>
