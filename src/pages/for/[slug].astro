---
import { readdirSync } from 'node:fs';
import Layout from '../../layouts/Layout.astro';
import BioRegenerator from '../../components/BioRegenerator.astro';
import Portrait from '../../components/Portrait.astro';
import {
  getAllFilters,
  getFilterPaths,
  getFilterWithStudies,
  type FilterConfig,
  type CaseStudy,
} from '../../data/cv-tailor';

export function getStaticPaths() {
  const filters = getAllFilters();
  return filters.flatMap((filter) =>
    getFilterPaths(filter).map((slug) => ({
      params: { slug },
      props: { filter },
    })));
}

const { filter } = Astro.props;
const data = getFilterWithStudies(filter.slug);

if (!data) {
  return Astro.redirect('/404');
}

const { studies } = data;
const featuredStudies = studies.filter(s => s.visibility === 'featured');
const browseableStudies = studies.filter(s => s.visibility === 'browseable');

// Cover resolution, done at build time against the real directory.
//
// Every study has a generated cover named after its id, and nothing was using
// them: the old chain ended at a hardcoded ChurchDesk graphic, so two unrelated
// Bibel TV studies rendered the same cemetery illustration side by side.
//
// Resolved here rather than inline because scripts/check-images.mjs matches
// literal /images/… paths and cannot see through a template string. Reading the
// directory keeps that guarantee: a study with no cover falls back to a file
// that is known to exist, instead of emitting a path that 404s.
const GENERATED_COVERS = new Set(
  readdirSync('public/images/covers/generated').filter((f) => f.endsWith('.svg'))
);
const COVER_DIR = '/images/covers/generated';
const COVER_FALLBACK = '/images/covers/generated/churchdesk-booking-system.svg';

function coverFor(study: any): string {
  if (study.cover_image) return study.cover_image;
  if (study.hero_image?.src) return study.hero_image.src;
  // Card rendition first: same seed and metaphor, drawn on a coarser grid so
  // the structure survives at 330px instead of collapsing into texture. Falls
  // back to the hero rendition, then to a file known to exist.
  const card = `${study.id}-card.svg`;
  if (GENERATED_COVERS.has(card)) return `${COVER_DIR}/${card}`;
  const own = `${study.id}.svg`;
  return GENERATED_COVERS.has(own) ? `${COVER_DIR}/${own}` : COVER_FALLBACK;
}

// Scoped case study routes: /for/{slug}/{study-id}
// No separate mapping needed — the scoped route IS the link

---
<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
</Fragment>


<Layout title="AI-Native Product & Design Leader">
  <section class="hero">
    <div class="container">
      <p class="hero-tagline">AI-Native Product &amp; Design Leader</p>
      <h1 class="animated-headline" id="animated-title">The design leader moving closer to the model</h1>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  if (title) {
    const text = title.textContent || '';
    title.innerHTML = text.split('').map((char, i) =>
      char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
    ).join('');
    const letters = title.querySelectorAll('.letter');
    letters.forEach((letter) => {
      let currentFontIndex = Math.floor(Math.random() * fonts.length);
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
      const animate = () => {
        const newIndex = Math.floor(Math.random() * fonts.length);
        currentFontIndex = newIndex;
        letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
        const nextInterval = 1500 + Math.random() * 2500;
        setTimeout(animate, nextInterval);
      };
      const delay = Math.random() * 5000;
      setTimeout(animate, delay);
    });
  }
</script>
      <div class="hero-bio">
        <Portrait
          alt="Tobias Treppmann, photographed on a Berlin rooftop, a church tower out of focus behind him"
        />
        <div class="hero-bio__text">
          <BioRegenerator bio={filter.bio} />
          {filter.subtitle && (
            <p class="context-note">{filter.subtitle}</p>
          )}
        </div>
      </div>
      {filter.cv?.href && (
        <p class="cv-link">
          <a href={filter.cv.href} download>{filter.cv.label || 'Download CV (PDF)'}</a>
          {filter.cv.note && <span class="cv-note">{filter.cv.note}</span>}
        </p>
      )}
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-header">
        <h2>Case Studies</h2>
        <p class="text-muted">Selected work demonstrating hands-on leadership and technical depth</p>
      </div>

      <div class="case-studies-grid">
        {featuredStudies.map((study: any) => {
          const heroSection = study.sections?.find((s: any) => s.type === 'hero');
          const outcomeSection = study.sections?.find((s: any) => s.type === 'outcome');
          const link = `/for/${filter.slug}/${study.id}`;
          const cover = coverFor(study);

          return (
            <a href={link} class="case-study-card">
              <img src={cover} alt={heroSection?.headline || study.title} class="case-study-cover" />
              <h3>{heroSection?.headline || study.title}</h3>
              <p class="subtitle">{[study.company, study.duration].filter(Boolean).join(" · ")}</p>
              <p>{heroSection?.subtext || study.subtitle}</p>
              <div style="margin-top: var(--space-md);">
                {study.tags.slice(0, 4).map((tag: string) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {browseableStudies.length > 0 && (
    <section class="section" id="more-work">
      <div class="container">
        <details class="show-more">
          <summary>{filter.show_all_label || 'Show more work'}</summary>
          <div class="case-studies-grid" style="margin-top: var(--space-lg);">
            {browseableStudies.map((study: any) => {
              const heroSection = study.sections?.find((s: any) => s.type === 'hero');
              const link = `/for/${filter.slug}/${study.id}`;
              const cover = coverFor(study);

              return (
                <a href={link} class="case-study-card">
                  <img src={cover} alt={heroSection?.headline || study.title} class="case-study-cover" />
                  <h3>{heroSection?.headline || study.title}</h3>
                  <p class="subtitle">{[study.company, study.duration].filter(Boolean).join(" · ")}</p>
                  <p>{heroSection?.subtext || study.subtitle}</p>
                  <div style="margin-top: var(--space-md);">
                    {study.tags.slice(0, 4).map((tag: string) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                </a>
              );
            })}
          </div>
        </details>
      </div>
    </section>
  )}

  {/* Mirrors the home page. These pages are what a recruiter actually lands on
      from an application, so anything worth showing on treppmann.design is
      worth showing here — the portrait above and this below. */}
  <section class="section" id="practice">
    <div class="container">
      <div class="section-header">
        <h2>Also</h2>
      </div>
      <div class="practice-list">
        <div class="practice-item">
          <h3>Selah &mdash; shipped Mac App Store app</h3>
          <p>
            A leadership tool I designed and built: 60&ndash;90 second structured
            transitions between meetings, so you arrive present rather than
            carrying the last conversation into the next one. Born from my own
            calendar hack, now a shipped product.
            <a href="https://selah.guide" rel="noopener">selah.guide</a>
          </p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .context-note {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-style: italic;
  }

  .show-more {
    border: none;
    cursor: pointer;
  }

  .show-more summary {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    padding: var(--space-md) 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .show-more summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent-light);
    font-weight: 600;
  }

  .show-more[open] summary::before {
    content: '−';
  }

  .cv-link {
    margin-top: var(--space-md);
    font-size: 0.95rem;
  }
  .cv-link a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 1px;
  }
  .cv-link a:hover { opacity: 0.75; }
  .cv-note {
    margin-left: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
