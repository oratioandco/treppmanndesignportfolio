---
import Layout from '../../layouts/Layout.astro';
import BioRegenerator from '../../components/BioRegenerator.astro';
import Portrait from '../../components/Portrait.astro';
import Selah from '../../components/Selah.astro';
import DotField from '../../components/DotField.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import {
  getAllFilters,
  getFilterPaths,
  getFilterWithStudies,
  type FilterConfig,
  type CaseStudy,
} from '../../data/cv-tailor';

export function getStaticPaths() {
  const filters = getAllFilters();
  return filters.flatMap((filter) =>
    getFilterPaths(filter).map((slug) => ({
      params: { slug },
      props: { filter },
    })));
}

const { filter } = Astro.props;
const data = getFilterWithStudies(filter.slug);

if (!data) {
  return Astro.redirect('/404');
}

const { studies } = data;
const featuredStudies = studies.filter(s => s.visibility === 'featured');
const browseableStudies = studies.filter(s => s.visibility === 'browseable');

// Cards no longer need a cover image — CaseStudyCard renders a generative
// motif client-side instead (see src/scripts/poster-motifs.js). The old
// coverFor() lookup against public/images/covers/generated/ is gone; those
// static SVGs are still used as case-study page HEROES, just not here.

// Scoped case study routes: /for/{slug}/{study-id}
// No separate mapping needed — the scoped route IS the link

// The tailored title, which until now rendered nowhere.
//
// Every application writes a `title` into its filter, and it passes the gate
// and gets published — but this page hardcoded the site headline, so all eight
// live pages opened with the same sentence to eight different hiring managers.
// The one line written specifically for the reader was the one line they never
// saw.
//
// Rendering it means the scaffolder's default renders too, and 22 of the 29
// filters still carry one. So a placeholder counts as no title: it falls back
// to the site headline rather than greeting a hiring manager with the word
// "Selected Work" set in 101px display serif.
const SITE_TAGLINE = 'AI-Native Product & Design Leader';
const SITE_HEADLINE = 'The design leader moving closer to the model';
const PLACEHOLDER_TITLES = new Set([
  'Selected Work',
  'Ausgewählte Arbeiten',
  // Not a placeholder by origin, but it repeats the tagline sitting directly
  // above the headline, so as an <h1> it says the same thing twice.
  SITE_TAGLINE,
]);

const tailoredTitle = (filter.title ?? '').trim();
const hasTailoredTitle =
  tailoredTitle !== '' && !PLACEHOLDER_TITLES.has(tailoredTitle);

const headline = hasTailoredTitle ? tailoredTitle : SITE_HEADLINE;
const documentTitle = hasTailoredTitle ? tailoredTitle : SITE_TAGLINE;

function preventDisplayWidow(text: string, keepWords = 2): string {
  const words = text.trim().split(/\s+/).filter(Boolean);
  const keep = Math.min(keepWords, words.length);
  if (words.length <= keep) return words.join('\u00A0');
  return `${words.slice(0, -keep).join(' ')} ${words.slice(-keep).join('\u00A0')}`;
}

const headlineDisplay = preventDisplayWidow(headline);

---
<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
</Fragment>


<Layout title={documentTitle}>
  <section class="hero hero--editorial hero--tailored">
    <DotField spacing={24} />
    <div class="container">
      <nav class="site-rail" aria-label="Portfolio navigation">
        <a href="/">Tobias Treppmann</a>
        <span>Selected for this role</span>
        <a href="mailto:hello@treppmann.design">Get in touch</a>
      </nav>

      <div class="editorial-hero__mast">
        <p class="hero-tagline">{SITE_TAGLINE}</p>
        <h1 class="animated-headline" id="animated-title">{headlineDisplay}</h1>
      </div>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  if (title) {
    const text = title.textContent || '';
    title.innerHTML = text.split('').map((char, i) =>
      char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
    ).join('');
    const letters = title.querySelectorAll('.letter');
    letters.forEach((letter) => {
      let currentFontIndex = Math.floor(Math.random() * fonts.length);
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
      const animate = () => {
        const newIndex = Math.floor(Math.random() * fonts.length);
        currentFontIndex = newIndex;
        letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
        const nextInterval = 1500 + Math.random() * 2500;
        setTimeout(animate, nextInterval);
      };
      const delay = Math.random() * 5000;
      setTimeout(animate, delay);
    });
  }
</script>
      <div class="editorial-hero__profile">
        <Portrait
          alt="Tobias Treppmann, photographed on a Berlin rooftop, a church tower out of focus behind him"
        />
        <div class="editorial-hero__bio">
          <BioRegenerator bio={filter.bio} />
          {filter.subtitle && (
            <p class="context-note">{filter.subtitle}</p>
          )}
        </div>
      </div>
      {filter.cv?.href && (
        <div class="editorial-hero__actions">
          <a href="#case-studies">View selected work <span aria-hidden="true">↓</span></a>
          <a href={filter.cv.href} download>{filter.cv.label || 'Download CV (PDF)'} <span aria-hidden="true">↓</span></a>
          {filter.cv.note && <span class="cv-note">{filter.cv.note}</span>}
        </div>
      )}
      {!filter.cv?.href && (
        <div class="editorial-hero__actions">
          <a href="#case-studies">View selected work <span aria-hidden="true">↓</span></a>
          <a href="mailto:hello@treppmann.design">Start a conversation <span aria-hidden="true">↗</span></a>
        </div>
      )}
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-header">
        <h2>Case Studies</h2>
        <p class="text-muted">Selected work demonstrating hands-on leadership and technical depth</p>
      </div>

      <div class="case-studies-grid">
        {featuredStudies.map((study: any) => {
          const heroSection = study.sections?.find((s: any) => s.type === 'hero');
          const link = `/for/${filter.slug}/${study.id}`;

          return (
            <CaseStudyCard
              href={link}
              headline={heroSection?.headline || study.title}
              caption={[study.company, study.duration].filter(Boolean).join(" · ")}
              studyId={study.id}
            />
          );
        })}
      </div>
    </div>
  </section>

  {browseableStudies.length > 0 && (
    <section class="section" id="more-work">
      <div class="container">
        <details class="show-more">
          <summary>{filter.show_all_label || 'Show more work'}</summary>
          <div class="case-studies-grid" style="margin-top: var(--space-lg);">
            {browseableStudies.map((study: any) => {
              const heroSection = study.sections?.find((s: any) => s.type === 'hero');
              const link = `/for/${filter.slug}/${study.id}`;

              return (
                <CaseStudyCard
                  href={link}
                  headline={heroSection?.headline || study.title}
                  caption={[study.company, study.duration].filter(Boolean).join(" · ")}
                  studyId={study.id}
                />
              );
            })}
          </div>
        </details>
      </div>
    </section>
  )}

  {/* Mirrors the home page. These pages are what a recruiter actually lands on
      from an application, so anything worth showing on treppmann.design is
      worth showing here — the portrait above and this below. */}
  <Selah />

</Layout>

<style>
  .context-note {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-style: italic;
  }

  .show-more {
    border: none;
    cursor: pointer;
  }

  .show-more summary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 500;
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .cv-note {
    grid-column: 1 / -1;
    color: #cfd9d4;
    font-size: 0.85rem;
  }
</style>
