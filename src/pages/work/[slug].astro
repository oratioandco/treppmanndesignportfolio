---
import Layout from '../../layouts/Layout.astro';
import BioRegenerator from '../../components/BioRegenerator.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import {
  getAllFilters,
  getFilterWithStudies,
  type FilterConfig,
  type CaseStudy,
} from '../../data/cv-tailor';

export function getStaticPaths() {
  const filters = getAllFilters();
  return filters.map((filter) => ({
    params: { slug: filter.slug },
    props: { filter },
  }));
}

const { filter } = Astro.props;
const data = getFilterWithStudies(filter.slug);

if (!data) {
  return Astro.redirect('/404');
}

const { studies } = data;
const featuredStudies = studies.filter(s => s.visibility === 'featured');
const browseableStudies = studies.filter(s => s.visibility === 'browseable');

// Scoped case study routes: /work/{slug}/{study-id}
// No separate mapping needed — the scoped route IS the link

// Cards no longer need a cover image — CaseStudyCard renders a generative
// motif client-side instead (see src/scripts/poster-motifs.js). The old
// coverFor() lookup against public/images/covers/generated/ is gone;
// those static SVGs are still used as case-study page HEROES, just not
// on the listing cards.
---

<Fragment slot="head">
  <meta name="robots" content="noindex, nofollow" />
</Fragment>


<Layout title="AI-Native Product & Design Leader">
  <section class="hero">
    <div class="container">
      <p class="hero-tagline">AI-Native Product &amp; Design Leader</p>
      <h1 class="animated-headline" id="animated-title">The design leader moving closer to the model</h1>

<script>
  const fonts = ['Redaction 20', 'Redaction 35', 'Redaction 50', 'Redaction 70'];
  const title = document.getElementById('animated-title');
  if (title) {
    const text = title.textContent || '';
    title.innerHTML = text.split('').map((char, i) =>
      char === ' ' ? ' ' : `<span class="letter" data-index="${i}">${char}</span>`
    ).join('');
    const letters = title.querySelectorAll('.letter');
    letters.forEach((letter) => {
      let currentFontIndex = Math.floor(Math.random() * fonts.length);
      letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
      const animate = () => {
        const newIndex = Math.floor(Math.random() * fonts.length);
        currentFontIndex = newIndex;
        letter.style.fontFamily = `"${fonts[currentFontIndex]}", Georgia, serif`;
        const nextInterval = 1500 + Math.random() * 2500;
        setTimeout(animate, nextInterval);
      };
      const delay = Math.random() * 5000;
      setTimeout(animate, delay);
    });
  }
</script>
      <BioRegenerator bio={filter.bio} />
      {filter.subtitle && (
        <p class="context-note">{filter.subtitle}</p>
      )}
      {filter.cv?.href && (
        <p class="cv-link">
          <a href={filter.cv.href} download>{filter.cv.label || 'Download CV (PDF)'}</a>
          {filter.cv.note && <span class="cv-note">{filter.cv.note}</span>}
        </p>
      )}
    </div>
  </section>

  <section class="section" id="case-studies">
    <div class="container">
      <div class="section-header">
        <h2>Case Studies</h2>
        <p class="text-muted">Selected work demonstrating hands-on leadership and technical depth</p>
      </div>

      <div class="case-studies-grid">
        {featuredStudies.map((study: any) => {
          const heroSection = study.sections?.find((s: any) => s.type === 'hero');
          const link = `/work/${filter.slug}/${study.id}`;

          return (
            <CaseStudyCard
              href={link}
              headline={heroSection?.headline || study.title}
              caption={[study.company, study.duration].filter(Boolean).join(" · ")}
              studyId={study.id}
            />
          );
        })}
      </div>
    </div>
  </section>

  {browseableStudies.length > 0 && (
    <section class="section" id="more-work">
      <div class="container">
        <details class="show-more">
          <summary>{filter.show_all_label || 'Show more work'}</summary>
          <div class="case-studies-grid" style="margin-top: var(--space-lg);">
            {browseableStudies.map((study: any) => {
              const heroSection = study.sections?.find((s: any) => s.type === 'hero');
              const link = `/work/${filter.slug}/${study.id}`;

              return (
                <CaseStudyCard
                  href={link}
                  headline={heroSection?.headline || study.title}
                  caption={[study.company, study.duration].filter(Boolean).join(" · ")}
                  studyId={study.id}
                />
              );
            })}
          </div>
        </details>
      </div>
    </section>
  )}

</Layout>

<style>
  .context-note {
    margin-top: var(--space-lg);
    font-size: 0.85rem;
    color: var(--color-accent);
    font-style: italic;
  }

  .show-more {
    border: none;
    cursor: pointer;
  }

  .show-more summary {
    font-size: 1rem;
    color: var(--color-accent);
    font-weight: 500;
    padding: var(--space-md) 0;
    list-style: none;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .show-more summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-accent-light);
    font-weight: 600;
  }

  .show-more[open] summary::before {
    content: '−';
  }

  .cv-link {
    margin-top: var(--space-md);
    font-size: 0.95rem;
  }
  .cv-link a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid var(--color-accent);
    padding-bottom: 1px;
  }
  .cv-link a:hover { opacity: 0.75; }
  .cv-note {
    margin-left: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
</style>
