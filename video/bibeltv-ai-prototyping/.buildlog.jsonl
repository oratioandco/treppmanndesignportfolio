{"ts": "2026-10-07T10:52", "cmd": "voice", "params": {"voice_id": "kMS8f1BmXMghbv2jguJo", "key_source": "/Users/ttreppmann/Developer/StudioProjects/product-ads/.env", "text": "It can't show banding on older Android. Or the screen a browser eats.", "out": "assets/vo1/b2-r1.mp3", "est_cost": 0.04, "regenerated": false}, "results": {"duration_s": 5.12}}
