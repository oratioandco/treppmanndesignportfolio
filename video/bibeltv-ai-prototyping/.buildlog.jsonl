{"ts": "2026-10-07T10:53", "cmd": "voice", "params": {"voice_id": "kMS8f1BmXMghbv2jguJo", "key_source": "/Users/ttreppmann/Developer/StudioProjects/product-ads/.env", "text": "The shipped app proves it: 91.8 percent of the design tokens. 94 percent of the data model.", "out": "assets/vo1/b6-r1.mp3", "est_cost": 0.05, "regenerated": false}, "results": {"duration_s": 6.8}}
